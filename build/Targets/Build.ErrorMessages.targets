<Project>
  <!-- The SDK's GenerateResource task emits and compiles this internal accessor during
       ordinary command-line builds, including CI and NativeAOT publication. -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\ErrorMessages.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedClassName>ErrorMessages</StronglyTypedClassName>
      <StronglyTypedNamespace>$(RootNamespace)</StronglyTypedNamespace>
      <StronglyTypedFileName>$(IntermediateOutputPath)ErrorMessages.g.cs</StronglyTypedFileName>
      <PublicClass>false</PublicClass>
      <ManifestResourceName>$(RootNamespace).ErrorMessages</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>
  <!-- Existing non-exception strings keep their resource file and accessor name. -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedClassName>Resources</StronglyTypedClassName>
      <StronglyTypedNamespace>$(RootNamespace)</StronglyTypedNamespace>
      <StronglyTypedFileName>$(IntermediateOutputPath)Resources.g.cs</StronglyTypedFileName>
      <PublicClass>false</PublicClass>
      <ManifestResourceName>$(RootNamespace).Resources</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
