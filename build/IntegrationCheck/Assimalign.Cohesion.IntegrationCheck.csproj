<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.IntegrationCheck</RootNamespace>
		<!-- build/ has no per-area Directory.Build.props applying the central TFM, so derive it here. -->
		<TargetFramework>$(TargetFrameworkLatest)</TargetFramework>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Http.ClientFactory" />
		<!-- Owner decision 34 (#1380): the Web feature packages' builder.Services.Add<Feature> verbs. -->
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Antiforgery" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Authentication" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Authorization" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.ErrorHandling" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.OpenApi" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Routing" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Serialization" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Validation" />
		<CohesionProjectReference Include="Assimalign.Cohesion.DependencyInjection" />
		<CohesionAnalyzerReference Include="Assimalign.Cohesion.SourceGeneration.ComponentModel" />
	</ItemGroup>
</Project>
