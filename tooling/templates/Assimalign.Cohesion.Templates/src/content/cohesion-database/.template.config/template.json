{
  "$schema": "http://json.schemastore.org/template",
  "author": "AssimAlign",
  "classifications": [
    "Cohesion",
    "Cloud"
  ],
  "identity": "Assimalign.Cohesion.Templates.database.CSharp",
  "name": "Cohesion database",
  "shortName": "cohesion-database",
  "sourceName": "CohesionProject",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "Framework": {
      "type": "parameter",
      "dataType": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": ".NET 10"
        }
      ],
      "defaultValue": "net10.0",
      "description": "The SDK target framework."
    },
    "nameLower": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLower": true
      }
    },
    "resource": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "nameLower",
        "steps": [
          {
            "regex": "[^a-z0-9]+",
            "replacement": "-"
          }
        ]
      },
      "replaces": "__RESOURCE_NAME__"
    }
  }
}
