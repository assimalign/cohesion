<Project Sdk="Assimalign.Cohesion.Sdk.SecretStore">
  <!--
    The appb-secretstore resource: an ordinary executable whose Program.cs composes the store, its certificate authority
    and its policies in C#. Mount sources `appb-secretstore:<key>` in sibling resources resolve here through the
    gateway — resources never pull. Default control plane commands: secretstore.secret, secretstore.certificate, secretstore.enroll.
    Sdk.SecretStore defaults: endpoint `api` (https 8443, private), mount `data` (Volume, 10Gi), workload StatefulSet, replicas 1.
  -->
  <PropertyGroup>
    <CohesionResourceName>appb-secretstore</CohesionResourceName>
    <!-- Opt-in to orchestration. Enabled: Sdk.SecretStore generates resource.json (the manifest), Resource.g.cs (typed accessors:
         Resource.Endpoints/Mounts/Settings/References over the ambient ResourceContext) and ResourceControlPlane.g.cs (the
         SecretStore default control plane — readiness, health, observed endpoints, stop, SecretStore commands — owned by
         SecretStore.ApplicationModel). Disabled (the default): a plain executable that no gateway can reference. -->
    <CohesionApplicationModel>enabled</CohesionApplicationModel>
  </PropertyGroup>
  <ItemGroup>
    <CohesionSetting Include="SecretStore:Issuer" Default="appb-secretstore" />
  </ItemGroup>
</Project>
