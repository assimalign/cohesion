<Project Sdk="Assimalign.Cohesion.Sdk.SecretStore">
  <!-- The organization's root of trust: an ordinary executable whose Program.cs composes the self-seeded org CA, the
       trusted-issuer registry and the issuance policies in C#. Nothing precedes the Platform gateway but kubeconfig and
       registry credentials. Default control plane commands: secretstore.secret, secretstore.certificate, secretstore.enroll.
       Sdk.SecretStore defaults: endpoint `api` (https 8443, private), mount `data` (Volume, 10Gi), StatefulSet, replicas 1. -->
  <PropertyGroup>
    <CohesionResourceName>platform-secretstore</CohesionResourceName>
    <!-- Opt-in to orchestration. Enabled: Sdk.SecretStore generates resource.json (the manifest), Resource.g.cs (typed accessors:
         Resource.Endpoints/Mounts/Settings/References over the ambient ResourceContext) and ResourceControlPlane.g.cs (the
         SecretStore default control plane — readiness, health, observed endpoints, stop, SecretStore commands — owned by
         SecretStore.ApplicationModel). Disabled (the default): a plain executable that no gateway can reference. -->
    <CohesionApplicationModel>enabled</CohesionApplicationModel>
  </PropertyGroup>
  <ItemGroup>
    <CohesionEndpoint Update="api" Public="true" />
    <CohesionSetting Include="SecretStore:Issuer" Default="platform-secretstore" />
  </ItemGroup>
</Project>
