<Project>
  <!-- Repository identity; executable and language defaults belong to the Cohesion SDK. -->
  <PropertyGroup>
    <CohesionOrganization>example</CohesionOrganization>
    <CohesionApplication>example</CohesionApplication>
    <!-- Replace the organization/registry with your own, or leave the registry empty for OCI archives. -->
    <CohesionContainerRegistry>ghcr.io/example</CohesionContainerRegistry>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>
</Project>
