<Project Sdk="Assimalign.Cohesion.Sdk.Gateway">
  <PropertyGroup>
    <CohesionApplicationName>__APPLICATION_NAME__</CohesionApplicationName>
    <CohesionGateways>InProcess;Local</CohesionGateways>
    <CohesionGatewayInProcess>true</CohesionGatewayInProcess>
  </PropertyGroup>
  <ItemGroup>
    <!-- Add enabled members here; a composite can itself be referenced by an outer gateway.
    <CohesionResourceReference Include="../Example.Api/Example.Api.csproj" />
    -->
    <!-- Store, certificate-authority and trust providers are opt-in packages that Program.cs registers explicitly.
    <CohesionPackageReference Include="Assimalign.Cohesion.SecretStore.ApplicationModel.Orchestration" Version="$(CohesionVersion)" />
    -->
  </ItemGroup>
</Project>
