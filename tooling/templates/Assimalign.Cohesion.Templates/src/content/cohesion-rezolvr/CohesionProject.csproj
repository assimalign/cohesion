<Project Sdk="Assimalign.Cohesion.Sdk.Rezolvr">
  <PropertyGroup>
    <!-- Opt-in to orchestration: change the next line to <CohesionApplicationModel>enabled</CohesionApplicationModel>.
         Generates resource.json, Resource.g.cs and ResourceControlPlane.g.cs; Assimalign.Cohesion.Rezolvr.ApplicationModel
         owns the generated default control plane. Without it this is a plain executable that a gateway cannot reference. -->
    <CohesionApplicationModel>disabled</CohesionApplicationModel>
  </PropertyGroup>
</Project>
