<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.OpenTelemetry</RootNamespace>
		<Description>Bounded, NativeAOT-safe OTLP/HTTP JSON log export without instrumentation or hosting dependencies.</Description>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Core" />
	</ItemGroup>
	<ItemGroup>
		<CohesionValueType Include="ValueObjects\OtlpTraceId.cs"
			ObjectRuntimeType="String" ObjectNamespace="Assimalign.Cohesion.OpenTelemetry"
			ObjectAccessModifier="public" ObjectHasImplicitOperators="true"
			ObjectHasIsValidMethod="true" ObjectComparison="OrdinalIgnoreCase" />
		<CohesionValueType Include="ValueObjects\OtlpSpanId.cs"
			ObjectRuntimeType="String" ObjectNamespace="Assimalign.Cohesion.OpenTelemetry"
			ObjectAccessModifier="public" ObjectHasImplicitOperators="true"
			ObjectHasIsValidMethod="true" ObjectComparison="OrdinalIgnoreCase" />
	</ItemGroup>
</Project>
