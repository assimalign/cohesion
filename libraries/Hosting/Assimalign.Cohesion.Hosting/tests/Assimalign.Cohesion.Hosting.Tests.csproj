<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Hosting.Tests</RootNamespace>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<CohesionPackageReference Include="Microsoft.NET.Test.Sdk" />
		<CohesionPackageReference Include="Shouldly" />
		<CohesionPackageReference Include="xunit" />
		<CohesionPackageReference Include="xunit.runner.visualstudio" />
		<CohesionPackageReference Include="coverlet.collector" />
	</ItemGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting.StartFailureFixture" ReferenceOutputAssembly="false" />
	</ItemGroup>
	<Target Name="CopyStartFailureFixture" AfterTargets="Build">
		<ItemGroup>
			<StartFailureFixtureOutput Include="$(MSBuildThisFileDirectory)..\fixtures\Assimalign.Cohesion.Hosting.StartFailureFixture\bin\$(Configuration)\$(TargetFramework)\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(StartFailureFixtureOutput)"
		      DestinationFiles="@(StartFailureFixtureOutput->'$(OutDir)StartFailureFixture\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" />
	</Target>
</Project>
