<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Shared, transport-agnostic authentication protocol abstractions for Cohesion: protocol parties and roles, published-entity metadata, message envelopes, response status, logout semantics, binding descriptors, and validation results. The OpenID Connect and SAML contract branches build on these.</Description>
  </PropertyGroup>
  <ItemGroup>
    <CohesionProjectReference Include="Assimalign.Cohesion.IdentityModel" />
  </ItemGroup>
  <ItemGroup>
    <!-- ModelSnapshot from the IdentityModel root; shared\EndpointLocation.cs is this
         project's own shared source, linked into the protocol branches that validate
         endpoint locations. Both are stateless statics - no instance crosses an
         assembly boundary. -->
    <CohesionSharedSource Include="Assimalign.Cohesion.IdentityModel" />
    <CohesionSharedSource Include="Assimalign.Cohesion.IdentityModel.Protocols" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Assimalign.Cohesion.IdentityModel.Protocols.Tests" />
  </ItemGroup>
</Project>
