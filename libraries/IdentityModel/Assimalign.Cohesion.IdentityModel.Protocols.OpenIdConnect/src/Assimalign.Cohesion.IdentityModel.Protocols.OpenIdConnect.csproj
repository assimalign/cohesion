<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Assimalign.Cohesion.IdentityModel.Protocols.OpenIdConnect</RootNamespace>
    <Description>OpenID Connect contract branch for Cohesion IdentityModel: provider and client metadata, authorization/token/ID token/UserInfo/logout contracts, and specification-oriented validation. Builds on Assimalign.Cohesion.IdentityModel.Protocols.</Description>
  </PropertyGroup>
  <ItemGroup>
    <CohesionProjectReference Include="Assimalign.Cohesion.IdentityModel.Protocols" />
  </ItemGroup>
  <ItemGroup>
    <!-- ModelSnapshot (descriptor materialization) and EndpointLocation (wire-exact
         endpoint validation), compiled in as stateless statics. -->
    <CohesionSharedSource Include="Assimalign.Cohesion.IdentityModel" Module="Materialization" />
    <CohesionSharedSource Include="Assimalign.Cohesion.IdentityModel.Protocols" Module="Endpoints" />
  </ItemGroup>
</Project>
