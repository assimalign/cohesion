<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- The HTTP feature packages share the Assimalign.Cohesion.Http namespace, so the
		     context.WebSockets extension member is discoverable without an extra using (matches
		     Assimalign.Cohesion.Http.ProtocolUpgrade and Assimalign.Cohesion.Http.ExtendedConnect). -->
		<RootNamespace>Assimalign.Cohesion.Http</RootNamespace>
		<Description>Server WebSockets for the Cohesion HTTP family. Owns the opening handshake on every protocol (RFC 6455 on HTTP/1.1 with Sec-WebSocket-Key and Sec-WebSocket-Accept; RFC 8441 and RFC 9220 extended CONNECT on HTTP/2 and HTTP/3; Sec-WebSocket-Version: 13 throughout, answered 400 or 426 when malformed or for another version), subprotocol selection, and permessage-deflate negotiation (RFC 7692, opt-in), then hands the stream to the BCL framing: applications receive a System.Net.WebSockets.WebSocket. context.WebSockets exposes IsWebSocketRequest, the requested subprotocols and AcceptWebSocketAsync. HTTP/1.1 rides the protocol-upgrade takeover (Assimalign.Cohesion.Http.ProtocolUpgrade); HTTP/2 and HTTP/3 ride the extended CONNECT tunnel (Assimalign.Cohesion.Http.ExtendedConnect). Policy (origins, keep-alive defaults, closing sockets on a server drain) ships in Assimalign.Cohesion.Web.WebSockets.</Description>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Http" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Http.ProtocolUpgrade" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Http.ExtendedConnect" />
	</ItemGroup>
</Project>
