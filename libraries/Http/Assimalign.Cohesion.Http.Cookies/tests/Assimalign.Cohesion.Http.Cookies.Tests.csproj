		<RootNamespace>Assimalign.Cohesion.Http.Cookies.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<ImplicitUsings>disable</ImplicitUsings>
		<!-- Cross-assembly JSON contexts must resolve generated value-type converters and metadata. -->
