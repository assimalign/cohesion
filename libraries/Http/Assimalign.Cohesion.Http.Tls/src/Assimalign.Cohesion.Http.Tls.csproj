<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Deviates from AGENTS.md namespace-matches-assembly per design decision:
		     HTTP feature packages surface their types in the Assimalign.Cohesion.Http
		     namespace so IHttpContext extension members (context.TlsConnection) are
		     discoverable without an extra using, and so call sites written while the
		     feature lived in core Http keep compiling (matches Assimalign.Cohesion.Http.Cookies
		     and Assimalign.Cohesion.Http.ExtendedConnect). -->
		<RootNamespace>Assimalign.Cohesion.Http</RootNamespace>
		<ImplicitUsings>disable</ImplicitUsings>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Http" />
		<!-- ITlsConnectionInfo, the handshake facet the server transport publishes on each
		     exchange's connection info. Connections is an App kernel root, so this adds no
		     framework member. -->
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections" />
	</ItemGroup>
</Project>
