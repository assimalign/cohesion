		<ImplicitUsings>disable</ImplicitUsings>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Core" />
	</ItemGroup>
	<ItemGroup>
		<CohesionValueType Include="ValueObjects\HttpFieldName.cs"
