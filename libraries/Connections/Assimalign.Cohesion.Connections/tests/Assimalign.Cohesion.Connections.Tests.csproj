<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Connections.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<CohesionPackageReference Include="coverlet.collector" />
		<CohesionPackageReference Include="Microsoft.NET.Test.Sdk" />
		<CohesionPackageReference Include="Shouldly" />
		<CohesionPackageReference Include="xunit" />
		<CohesionPackageReference Include="xunit.runner.visualstudio" />
	</ItemGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.InMemory" />
	</ItemGroup>
	<ItemGroup>
		<!-- DuplexPipePairTests covers the Connections shared\ source, which the library itself
		     does not compile in (no type in Connections produces or consumes one). The suite
		     therefore links the same files the drivers do. -->
		<CohesionSharedSource Include="Assimalign.Cohesion.Connections" Module="Pipes" />
	</ItemGroup>
	<ItemGroup>
		<Compile Include="$(CohesionRepositoryDirectory)build\TestSupport\EventSourceRecorder.cs" Link="Shared\EventSourceRecorder.cs" />
	</ItemGroup>
</Project>
