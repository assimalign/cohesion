<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- The definition side shares the ApplicationModel namespace, so a gateway's Program.cs
		     composes the whole model with one using. -->
		<RootNamespace>Assimalign.Cohesion.ApplicationModel</RootNamespace>
		<Description>Cohesion application model definitions: the logical model of one gateway, from the application resources it deploys, their dependencies and permissions, settings, platform extensions, and outputs to the parent gateway it joins and the model manifest that describes it all.</Description>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Core" />
		<CohesionProjectReference Include="Assimalign.Cohesion.ApplicationModel" />
	</ItemGroup>
	<ItemGroup>
		<!-- The hyphenated-words grammar output and extension names share with the root's platform names. -->
		<CohesionSharedSource Include="Assimalign.Cohesion.ApplicationModel" Module="Names" />
	</ItemGroup>
	<ItemGroup>
		<CohesionValueType Include="ValueObjects\GatewayName.cs" ObjectRuntimeType="String" ObjectNamespace="Assimalign.Cohesion.ApplicationModel" ObjectAccessModifier="public" ObjectHasImplicitOperators="true" ObjectHasIsValidMethod="true" ObjectComparison="Ordinal" />
		<CohesionValueType Include="ValueObjects\GatewayId.cs" ObjectRuntimeType="Guid" ObjectNamespace="Assimalign.Cohesion.ApplicationModel" ObjectAccessModifier="public" ObjectHasImplicitOperators="true" />
		<CohesionValueType Include="ValueObjects\Permission.cs" ObjectRuntimeType="String" ObjectNamespace="Assimalign.Cohesion.ApplicationModel" ObjectAccessModifier="public" ObjectHasImplicitOperators="true" ObjectHasIsValidMethod="true" ObjectComparison="Ordinal" />
		<CohesionValueType Include="ValueObjects\OutputName.cs" ObjectRuntimeType="String" ObjectNamespace="Assimalign.Cohesion.ApplicationModel" ObjectAccessModifier="public" ObjectHasImplicitOperators="true" ObjectHasIsValidMethod="true" ObjectComparison="Ordinal" />
		<CohesionValueType Include="ValueObjects\ExtensionName.cs" ObjectRuntimeType="String" ObjectNamespace="Assimalign.Cohesion.ApplicationModel" ObjectAccessModifier="public" ObjectHasImplicitOperators="true" ObjectHasIsValidMethod="true" ObjectComparison="Ordinal" />
		<!-- Configuration keys compare case-insensitively, so setting names do too. -->
		<CohesionValueType Include="ValueObjects\SettingName.cs" ObjectRuntimeType="String" ObjectNamespace="Assimalign.Cohesion.ApplicationModel" ObjectAccessModifier="public" ObjectHasImplicitOperators="true" ObjectHasIsValidMethod="true" ObjectComparison="OrdinalIgnoreCase" />
	</ItemGroup>
</Project>
