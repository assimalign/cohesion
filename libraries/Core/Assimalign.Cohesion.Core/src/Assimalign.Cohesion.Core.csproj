<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>Assimalign.Cohesion.Core</PackageId>
		<RootNamespace>Assimalign.Cohesion</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="Internal\TypeHelper.cs" />
		<Compile Remove="System\Net\CidrBlock.cs" />
	</ItemGroup>
	<ItemGroup>
		<Folder Include="System\Decorators\" />
	</ItemGroup>
	<ItemGroup>
		<!-- Ships the component-integration generator inside Core's own nupkg at
		     analyzers/dotnet/cs/. Core is in every Cohesion consumer's graph, and a packed
		     analyzer is picked up transitively, so this is the single delivery point for
		     PackageReference consumers. SDK consumers get it from App.Ref instead. -->
		<CohesionAnalyzerReference Include="Assimalign.Cohesion.SourceGeneration" />
	</ItemGroup>
</Project>
