<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Content.Ebml</RootNamespace>
		<Description>
			A .NET implementation for working with Extensible Binary Meta Language (EBML) format
			as a generic binary container format. EBML is designed as a binary
			equivalent to XML and uses a storage-efficient approach to build nested Elements 
			with identifiers, lengths, and values. Similar to how an XML Schema defines the structure 
			and semantics of an XML Document, this document defines how EBML Schemas are created to convey the semantics of an EBML Document.

			RFC Reference: https://datatracker.ietf.org/doc/html/rfc8794
		</Description>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Content.Binary" />
	</ItemGroup>
</Project>
