<Project>
    <!--
        Authoritative list of assemblies that ship in the Cohesion shared
        framework family (Assimalign.Cohesion.App, .App.Web, .App.Database).

        Multiple consumers read this file:

          1. frameworks/Assimalign.Cohesion.App[.Web|.Database].Runtime/src/...csproj
             Generates <CohesionProjectReference> items so each library is
             built and CopyLocal'd into the Runtime project's bin folder.

          2. frameworks/Assimalign.Cohesion.App[.Web|.Database].Refs/src/...csproj
             (and indirectly, Assimalign.Cohesion.App.targets) drives
             FrameworkList.xml and RuntimeList.xml generation - no DLL
             inspection needed.

        The ItemGroups below are conditioned on $(CohesionFrameworkName), which
        every Refs/Runtime csproj sets in its PropertyGroup BEFORE importing
        this file. The right set of <CohesionFrameworkAssembly> items lights
        up for the current framework; other frameworks' items don't exist
        in this evaluation. Property-based conditions on top-level ItemGroups
        are MSBuild-legal (item-metadata-based conditions are not - hence
        the property approach rather than a single list with %(Framework)
        metadata).

        The umbrella assembly per framework (Assimalign.Cohesion.App.dll,
        .App.Web.dll, .App.Database.dll) is included so the manifest lists
        it; the corresponding Runtime csproj skips it when generating
        ProjectReferences (you can't reference yourself).

        Inheritance: each SDK auto-includes the right set of <FrameworkReference>s:
            Sdk          -> App
            Sdk.Web      -> App + App.Web
            Sdk.Database -> App + App.Database
        See sdks/Assimalign.Cohesion.Sdk[.Web|.Database]/Sdk/Sdk.props.

        ================================================================
        Public vs private assemblies
        ================================================================
        Two parallel item types are recognized per framework:

          @(CohesionFrameworkAssembly)         - PUBLIC. Listed on the Ref
                                                 pack's FrameworkList.xml AND
                                                 shipped in the Runtime pack.
                                                 Visible to consumers at
                                                 compile time (IntelliSense
                                                 sees these types).

          @(CohesionFrameworkPrivateAssembly)  - PRIVATE. NOT listed on the
                                                 Ref pack. Shipped in the
                                                 Runtime pack only, and
                                                 enumerated in RuntimeList.xml
                                                 so the host resolves them.

        Use the private bucket when a framework needs another framework's
        library as an *implementation detail* at runtime but should not
        surface that library to consumers at compile time. The canonical
        example: App.Database needs Assimalign.Cohesion.Web internally to
        host its database server, but a developer using Sdk.Database should
        see only database types in IntelliSense - never web types.

        The library that needs the cross-resource type takes a normal
        CohesionProjectReference on the other library inside the repo, and
        keeps every cross-resource use `internal`. The private-assembly
        list is what hides that detail in the shipped artifact.
    -->

    <!-- ================================================================
         Assimalign.Cohesion.App: the base framework. Bundled with every
         Cohesion app via the base SDK.
         ================================================================ -->
    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Amqp" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Amqp.Connections" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Caching" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Caching.InMemory" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Configuration" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Configuration.CommandLine" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Configuration.EnvironmentVariables" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Configuration.FileSystem" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Configuration.Ini" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Configuration.Json" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Configuration.Xml" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Core" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.DependencyInjection" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Dns" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Dns.Client" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Dns.Client.Dot" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Dns.Client.Doh" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Dns.Client.Doq" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.FileSystem" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.FileSystem.Globbing" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.FileSystem.InMemory" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.FileSystem.Physical" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.FileSystem.IsolatedStorage" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.FileSystem.Aggregate" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Hosting" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Logging" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Logging.Debug" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Logging.Console" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Connections" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.ObjectPool" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.ObjectValidation" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.ObjectMapping" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Resilience" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Resilience.CircuitBreaker" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Resilience.Fallback" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Resilience.Hedging" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Resilience.RateLimiting" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Resilience.Retry" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Resilience.Timeout" />

        <!--
            Roslyn analyzers / source generators shipped INSIDE this framework's
            Ref pack at analyzers/dotnet/cs/. SDK-path consumers (i.e. anyone
            using <Project Sdk="Assimalign.Cohesion.Sdk">) auto-pick these up
            via the .NET SDK's ResolveTargetingPackAssets, the same way a
            direct <PackageReference> consumer auto-picks up the analyzer
            bundled inside the owning library's own .nupkg. By-name lookup
            against analyzers/**/*.csproj.

            MapperProfileGenerator emits TryConfigureGenerated overrides for
            subclasses of Assimalign.Cohesion.ObjectMapping.MapperProfile<T,S>,
            which is why it ships with the App framework (where ObjectMapping
            lives).
        -->
        <CohesionFrameworkAnalyzer Include="Assimalign.Cohesion.SourceGeneration" />
        <!-- Projects [assembly: ComponentIntegration] declarations into consuming-compilation extension verbs. -->
        <CohesionFrameworkAnalyzer Include="Assimalign.Cohesion.SourceGeneration.ComponentModel" />

        <!-- WIP / not yet building - uncomment as each library comes online:
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.OpenTelemetry" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Security" />
        -->
    </ItemGroup>

    <!-- ================================================================
         Assimalign.Cohesion.App.Web: HTTP / web extension. Added on top
         of App by Sdk.Web.

         The framework is what delivers the Web family to applications:
         the hosting/runtime module (Assimalign.Cohesion.Web.Hosting)
         deliberately has NO project references to the feature libraries,
         and the feature libraries never reference the hosting module -
         apps see the whole family because Sdk.Web pulls this framework
         (Web-area dependency rule: resources/Web/README.md).

         Exclusions: Web.Testing (test harness, not runtime) and
         Web.ApplicationModel (NuGet-only; Sdk.Web injects it only for an
         orchestration-enabled executable).
         ================================================================ -->
    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.Web'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.Web" />

        <!-- The Web family. -->
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.Api" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.Authentication" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.Authentication.Bearer" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.Authentication.Cookie" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.Authorization" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.Caching" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.Compression" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.CookiePolicy" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.Cors" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.Diagnostics" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.ErrorHandling" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.Forms" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.ForwardedHeaders" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.Health" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.HostFiltering" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.Hosting" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.HttpsPolicy" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.ProblemDetails" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.Query" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.RateLimiting" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.RequestTimeouts" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.Routing" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.Serialization" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.Sessions" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Web.StaticFiles" />

        <!-- Supporting libraries the Web family closes over that the base App
             framework does not carry (computed transitive closure). -->
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Http" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Http.Connections" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Http.Cookies" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Http.Forms" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Http.Forwarded" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Http.RequestLimits" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Http.Sessions" />

        <!-- App-facing HTTP capabilities delivered deliberately even though no Web
             assembly references them: incremental response streaming and the
             Server-Sent Events primitives ride the transport interceptor seam and
             are consumed directly by application handlers. -->
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Http.Streaming" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Http.ServerSentEvents" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Connections.Quic" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Connections.Security" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Connections.Tcp" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.IdentityModel" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.IdentityModel.Token" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.IdentityModel.Token.JsonWebToken" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Security.DataProtection" />

        <!-- The typed-delegate endpoint-binding source generator ships with the Web framework so
             Sdk.Web consumers' typed Map* call sites are intercepted (delivered under
             analyzers/dotnet/cs, the same mechanism as the base MapperProfileGenerator above). -->
        <CohesionFrameworkAnalyzer Include="Assimalign.Cohesion.SourceGeneration.Web" />

        <!-- Candidates as they come online:
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Http.ClientFactory" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.IdentityModel.Protocols" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.IdentityModel.Protocols.OpenIdConnect" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.IdentityModel.Protocols.Saml" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.IdentityModel.Token.Saml" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.OpenApi" />
        -->
    </ItemGroup>

    <!-- ================================================================
         Assimalign.Cohesion.App.Database: database extension. Added on top
         of App by Sdk.Database. Starts with just the umbrella.
         ================================================================ -->
    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.Database'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.Database" />

        <!-- The kernel: the contract root plus the child roots it rolls up
             (storage/durability, the ACID substrate, types, execution, the shared
             language infra, wire protocol, security, governance - the root
             REFERENCES all of them, so every child root in the root's closure
             must ship), and indexing (a kernel consumer of the root). -->
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Types" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Language" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Storage" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Transactions" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Indexing" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Execution" />
        <!-- Governance is a near-empty contracts shell (#167 fills it), but the
             child-root inversion (2026-07-13) put it in the root's reference
             closure, so the framework must deliver it. -->
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Governance" />

        <!-- Service surface: wire protocol, client core, security, the embedded
             facade, and the composition-only hosting module. Servers are per-model
             and ship inside their model package, each carrying its own copy of the
             server machinery (owner decision 2026-07-14 - the root contract is the
             only area-wide server requirement; there is no shared server library). -->
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Protocol" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Security" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Client" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Embedded" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Hosting" />

        <!-- The SQL model family (the MVP engine): engine + wire-protocol server,
             dialect, catalog, model storage, and the typed client. -->
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Sql" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Sql.Language" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Sql.Catalog" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Sql.Storage" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.Sql.Client" />

        <!-- The KeyValuePair model family (the second model - the kernel-generality
             proof): engine + wire-protocol server, model storage, the minimal
             catalog, and the typed client. -->
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.KeyValuePair" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.KeyValuePair.Storage" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.KeyValuePair.Catalog" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Database.KeyValuePair.Client" />

        <!--
            Deliberately EXCLUDED from the MVP framework:
            - Database.Testing - the packaged resource-program test harness. It
              drives Database.Hosting under a test-scoped ResourceContext but is
              tooling for tests, never part of an application's runtime closure.
            - Database.SampleHost - the non-packable real-process E2E resource
              executable under resources/Database/samples; never shipped.
            - The Documents/Graph/Blob/Cache model families - engine scaffolds
              without shipping surface yet. (KeyValuePair graduated into the
              shipping set 2026-07-14; its still-source-less satellites -
              KeyValuePair.Replication and KeyValuePair.Security - stay excluded
              until they ship.)
            - Database.ApplicationModel - NuGet-only orchestration and default-control-plane
              package, injected by Sdk.Database only when CohesionApplicationModel=enabled.
            - Database.Memory - empty in-memory-strategy placeholder (no sources).
            - Database.Replication, Database.Sql.Replication, Database.Sql.Security
              - post-MVP contracts-only/empty shells (replication / #177). Add each
              when its feature ships. (Database.Governance graduated into the
              shipping set with the child-root inversion - see the kernel group.)

            Private implementation dependencies. Shipped in App.Database's Runtime
            pack but NOT listed on its Ref pack - consumers of Sdk.Database never
            see these in IntelliSense, but the host resolves them at run time.

            Pairs with the Database area's private Web references: the runtime pack
            carries the HTTP control-plane implementation without exposing it through
            the Database reference pack.
        -->
        <CohesionFrameworkPrivateAssembly Include="Assimalign.Cohesion.Web" />
        <CohesionFrameworkPrivateAssembly Include="Assimalign.Cohesion.Web.Hosting" />
        <CohesionFrameworkPrivateAssembly Include="Assimalign.Cohesion.Web.Health" />
        <CohesionFrameworkPrivateAssembly Include="Assimalign.Cohesion.Web.Routing" />
        <CohesionFrameworkPrivateAssembly Include="Assimalign.Cohesion.Http" />
        <CohesionFrameworkPrivateAssembly Include="Assimalign.Cohesion.Http.Connections" />
        <CohesionFrameworkPrivateAssembly Include="Assimalign.Cohesion.Http.RequestLimits" />
        <CohesionFrameworkPrivateAssembly Include="Assimalign.Cohesion.Connections.Tcp" />
        <CohesionFrameworkPrivateAssembly Include="Assimalign.Cohesion.Connections.Quic" />
        <CohesionFrameworkPrivateAssembly Include="Assimalign.Cohesion.Connections.Security" />
    </ItemGroup>

    <!-- ================================================================
         Resource-domain frameworks. Each corresponds to a folder under
         resources/ and ships an empty umbrella assembly until you add
         projects to its ItemGroup. Adding a project is a one-line
         <CohesionFrameworkAssembly> entry plus a matching csproj under
         resources/<Name>/* that CohesionProjectReference can resolve.
         ================================================================ -->
    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.ApiManager'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.ApiManager" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.ApiManager" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.ApiManager.Hosting" />
    </ItemGroup>

    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.ConfigurationStore'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.ConfigurationStore" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.ConfigurationStore" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.ConfigurationStore.Hosting" />
    </ItemGroup>

    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.EmailHub'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.EmailHub" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.EmailHub" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.EmailHub.Hosting" />
    </ItemGroup>

    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.EventHub'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.EventHub" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.EventHub" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.EventHub.Hosting" />
    </ItemGroup>

    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.IdentityHub'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.IdentityHub" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.IdentityHub" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.IdentityHub.Hosting" />
    </ItemGroup>

    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.IoTHub'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.IoTHub" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.IoTHub" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.IoTHub.Hosting" />
    </ItemGroup>

    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.LoadBalancer'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.LoadBalancer" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.LoadBalancer" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.LoadBalancer.Hosting" />
    </ItemGroup>

    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.LogSpace'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.LogSpace" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.LogSpace" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.LogSpace.Hosting" />
    </ItemGroup>

    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.MediaHub'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.MediaHub" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.MediaHub" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.MediaHub.Hosting" />
    </ItemGroup>

    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.MessageHub'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.MessageHub" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.MessageHub" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.MessageHub.Hosting" />
    </ItemGroup>

    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.NatGateway'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.NatGateway" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.NatGateway" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.NatGateway.Hosting" />
    </ItemGroup>

    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.NotificationHub'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.NotificationHub" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.NotificationHub" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.NotificationHub.Hosting" />
    </ItemGroup>

    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.Rezolvr'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.Rezolvr" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Rezolvr" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Rezolvr.Hosting" />
    </ItemGroup>

    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.Scheduler'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.Scheduler" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Scheduler" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.Scheduler.Hosting" />
    </ItemGroup>

    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.SecretStore'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.SecretStore" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.SecretStore" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.SecretStore.Hosting" />
    </ItemGroup>

    <ItemGroup Condition="'$(CohesionFrameworkName)' == 'Assimalign.Cohesion.App.VpnGateway'">
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.App.VpnGateway" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.VpnGateway" />
        <CohesionFrameworkAssembly Include="Assimalign.Cohesion.VpnGateway.Hosting" />
    </ItemGroup>
</Project>
