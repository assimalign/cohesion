<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<!-- This marker must precede the base Sdk.props import so its pre-.NET defaults select Exe. -->
	<PropertyGroup>
		<_CohesionResourceSdk>true</_CohesionResourceSdk>
	</PropertyGroup>
	<!--
		Chain to the base Cohesion SDK, which registers the complete Cohesion framework
		family but auto-includes no framework itself.
	-->
	<!-- Consumers of Sdk.Database also need to pin Assimalign.Cohesion.Sdk in
	     their global.json's msbuild-sdks block. <Import Sdk="X/version"> syntax
	     isn't honored - only <Project Sdk="X/version"> is. -->
	<Import Sdk="Assimalign.Cohesion.Sdk" Project="Sdk.props" />

	<!--
		A Database resource receives the hosting kernel and its area framework.
	-->
	<ItemGroup Condition="'$(CohesionAutoIncludeAppFramework)' != 'false'">
		<FrameworkReference Include="Assimalign.Cohesion.App" />
		<FrameworkReference Include="Assimalign.Cohesion.App.Database" />
	</ItemGroup>

	<!--
		Database-project defaults and build-task registrations (schema compile,
		migration tooling). Model-specific tool wiring is imported from the
		matching Sdk.Database.<Model>.targets by the Migration targets.
	-->
	<Import Project="..\Targets\Sdk.Database.props" />
</Project>
