<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Sdk.Database.Tests</RootNamespace>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<GenerateDependencyFile>true</GenerateDependencyFile>
		<IncludeBuildOutput>true</IncludeBuildOutput>
		<IsAotCompatible>true</IsAotCompatible>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>
	<ItemGroup>
		<!-- An explicit ProjectPath: the name-only resolver indexes libraries/ and resources/,
		     not sdks/, so an SDK task project has to be named by path. Relative to this test
		     project, which sits at Tasks/tests/ beside the task project's Tasks/src/. -->
		<CohesionProjectReference
			Include="Assimalign.Cohesion.Sdk.Database.Tasks"
			ProjectPath="..\src\Assimalign.Cohesion.Sdk.Database.Tasks.csproj" />
	</ItemGroup>
	<ItemGroup>
		<CohesionPackageReference Include="Microsoft.Build" />
		<CohesionPackageReference Include="Microsoft.Build.Framework" />
		<CohesionPackageReference Include="Microsoft.Build.Utilities.Core" />
		<CohesionPackageReference Include="Microsoft.NET.Test.Sdk" />
		<CohesionPackageReference Include="Shouldly" />
		<CohesionPackageReference Include="xunit" />
		<CohesionPackageReference Include="xunit.runner.visualstudio" />
	</ItemGroup>
</Project>
