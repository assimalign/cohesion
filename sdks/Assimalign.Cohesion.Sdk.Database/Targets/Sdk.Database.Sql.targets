<Project>
	<PropertyGroup>
		<_CohesionDatabaseModelTargetsLoaded>true</_CohesionDatabaseModelTargetsLoaded>
		<_CohesionDatabaseModelCompileTarget>_CohesionCompileSqlDatabaseSchema</_CohesionDatabaseModelCompileTarget>
	</PropertyGroup>

	<!--
		One artifact pair per declared database lands in the output directory, so the
		set of outputs is known only to the task; the manifest the task writes on every
		successful compile, listing those databases, is the target's incremental output.
	-->
	<Target
		Name="_CohesionCompileSqlDatabaseSchema"
		Condition="'$(CohesionDatabaseProject)' == 'true'"
		Inputs="@(Compile);@(ReferencePath);$(_CohesionDatabaseTaskAssembly)"
		Outputs="$(_CohesionDatabaseSchemaManifest)">
		<CompileDatabaseSchemaTask
			SourceFiles="@(Compile)"
			ReferencePaths="@(ReferencePath)"
			DefineConstants="$(DefineConstants)"
			LanguageVersion="$(LangVersion)"
			AssemblyName="$(AssemblyName)"
			Model="Sql"
			ProjectDirectory="$(MSBuildProjectDirectory)"
			OutputDirectory="$(CohesionDatabaseSchemaOutputDirectory)" />
	</Target>
</Project>
