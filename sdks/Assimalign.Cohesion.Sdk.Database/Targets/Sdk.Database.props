<Project>
	<!--
		Area orchestration defaults use Include so a consuming project can override
		a named item with Update, for example:
		<CohesionEndpoint Update="db" DevPort="15740" />.
		The resource's domain composition remains in its Program.cs.
	-->
	<PropertyGroup>
		<CohesionResourceApplicationModel Condition="'$(CohesionResourceApplicationModel)' == ''">Assimalign.Cohesion.Database.ApplicationModel</CohesionResourceApplicationModel>
		<CohesionResourceControlPlaneType Condition="'$(CohesionResourceControlPlaneType)' == ''">Assimalign.Cohesion.Database.ApplicationModel.DatabaseResourceControlPlane</CohesionResourceControlPlaneType>
		<CohesionResourceKind Condition="'$(CohesionResourceKind)' == ''">Database</CohesionResourceKind>
		<CohesionControlPlaneEndpoint Condition="'$(CohesionControlPlaneEndpoint)' == ''">admin</CohesionControlPlaneEndpoint>
		<CohesionControlPlanePath Condition="'$(CohesionControlPlanePath)' == ''">/cohesion/v1</CohesionControlPlanePath>
		<CohesionWorkloadKind Condition="'$(CohesionWorkloadKind)' == ''">StatefulSet</CohesionWorkloadKind>
		<CohesionReplicas Condition="'$(CohesionReplicas)' == ''">1</CohesionReplicas>
		<CohesionMaxReplicas Condition="'$(CohesionMaxReplicas)' == ''">1</CohesionMaxReplicas>
	</PropertyGroup>

	<ItemGroup>
		<CohesionCommand Include="database.add-database;database.add-principal" />
		<CohesionEndpoint Include="db" Scheme="cohesion-db" ContainerPort="5740" Public="false" />
		<CohesionEndpoint Include="admin" Scheme="http" ContainerPort="8081" Public="false" />
		<CohesionProbe Include="readiness" Endpoint="admin" Http="/readyz" />
		<CohesionProbe Include="liveness" Endpoint="admin" Http="/livez" />
		<CohesionMount Include="data" Kind="Volume" ContainerPath="/data" Size="10Gi" />
	</ItemGroup>

	<!--
		The Tasks DLL sits next to Sdk/ and Targets/ in the packaged SDK. Keep its
		path in one property so it can also participate in incremental-build inputs.
	-->
	<PropertyGroup>
		<_CohesionDatabaseTaskAssembly>$(MSBuildThisFileDirectory)..\Tasks\Assimalign.Cohesion.Sdk.Database.Tasks.dll</_CohesionDatabaseTaskAssembly>
	</PropertyGroup>
	<UsingTask
		TaskName="Assimalign.Cohesion.Sdk.Database.Tasks.CompileDatabaseSchemaTask"
		AssemblyFile="$(_CohesionDatabaseTaskAssembly)"
		Runtime="NET" />
	<UsingTask
		TaskName="Assimalign.Cohesion.Sdk.Database.Tasks.CreateDatabaseMigrationTask"
		AssemblyFile="$(_CohesionDatabaseTaskAssembly)"
		Runtime="NET" />

	<PropertyGroup>
		<!-- Consumer applications opt in to build-time compilation of their retained C# schema. -->
		<CohesionDatabaseProject Condition="'$(CohesionDatabaseProject)' == ''">false</CohesionDatabaseProject>

		<!--
			The exact, case-sensitive model name selects
			Targets/Sdk.Database.<Model>.targets. The import is static MSBuild
			evaluation; no consumer assembly or plug-in is loaded into the task host.
		-->
		<CohesionDatabaseModel Condition="'$(CohesionDatabaseModel)' == ''">Sql</CohesionDatabaseModel>

		<!-- Where generated migration scripts live, relative to the project. -->
		<CohesionDatabaseMigrationsRoot Condition="'$(CohesionDatabaseMigrationsRoot)' == ''">Migrations</CohesionDatabaseMigrationsRoot>

	</PropertyGroup>
</Project>
