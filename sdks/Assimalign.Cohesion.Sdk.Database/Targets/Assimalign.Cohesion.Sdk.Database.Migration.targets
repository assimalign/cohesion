<Project>
	<!--
		Set artifact defaults after Microsoft.NET.Sdk has finalized the per-target-
		framework IntermediateOutputPath. Consumer overrides set earlier are kept.
		Each declared database writes <database>.schema.json and <database>.schema.sha256
		into the output directory, and the manifest beside them lists those databases. The
		manifest is the model compile target's incremental output and the only record of
		which files in the directory the SDK owns, so a deleted directory, a deleted
		artifact or a new output directory each trigger a recompile, and a foreign
		*.schema.json in an overridden directory is neither deleted nor read.
	-->
	<PropertyGroup>
		<CohesionDatabaseSchemaOutputDirectory Condition="'$(CohesionDatabaseSchemaOutputDirectory)' == ''">$(IntermediateOutputPath)cohesion/database/</CohesionDatabaseSchemaOutputDirectory>
		<CohesionDatabaseSchemaOutputDirectory Condition="!HasTrailingSlash('$(CohesionDatabaseSchemaOutputDirectory)')">$(CohesionDatabaseSchemaOutputDirectory)/</CohesionDatabaseSchemaOutputDirectory>
		<_CohesionDatabaseSchemaManifest>$(CohesionDatabaseSchemaOutputDirectory)schemas.manifest</_CohesionDatabaseSchemaManifest>
	</PropertyGroup>

	<!--
		Allowlisted static imports keep model selection deterministic and prevent a
		consumer-controlled property from becoming an arbitrary import path. Each
		model file registers its own compile target.
	-->
	<Import
		Project="$(MSBuildThisFileDirectory)Sdk.Database.Sql.targets"
		Condition="$([System.String]::Equals('$(CohesionDatabaseModel)', 'Sql', System.StringComparison.Ordinal))" />
	<Import
		Project="$(MSBuildThisFileDirectory)Sdk.Database.KeyValuePair.targets"
		Condition="$([System.String]::Equals('$(CohesionDatabaseModel)', 'KeyValuePair', System.StringComparison.Ordinal))" />

	<Target
		Name="_CohesionDatabaseValidateModel"
		Condition="'$(CohesionDatabaseProject)' == 'true'">
		<Error
			Code="COHDBSDK001"
			Condition="'$(_CohesionDatabaseModelTargetsLoaded)' != 'true'"
			Text="Database model '$(CohesionDatabaseModel)' is not supported by Assimalign.Cohesion.Sdk.Database. Supported models are 'Sql' and 'KeyValuePair'; model names are case-sensitive." />
		<Error
			Code="COHDBSDK002"
			Condition="'$(_CohesionDatabaseModelCompileTarget)' == ''"
			Text="Database model tool set '$(CohesionDatabaseModel)' did not register a schema compile target. Set _CohesionDatabaseModelCompileTarget in Sdk.Database.$(CohesionDatabaseModel).targets." />
	</Target>

	<!--
		An artifact the manifest lists but that is gone (deleted by hand, say) makes the
		manifest stale: deleting it puts the model compile target out of date, so the
		artifacts are written again instead of the build reading a partial set.
	-->
	<Target
		Name="_CohesionDatabaseCheckSchemaArtifacts"
		Condition="'$(CohesionDatabaseProject)' == 'true' and Exists('$(_CohesionDatabaseSchemaManifest)')">
		<ReadLinesFromFile File="$(_CohesionDatabaseSchemaManifest)">
			<Output TaskParameter="Lines" ItemName="_CohesionDatabaseRecordedSchema" />
		</ReadLinesFromFile>
		<ItemGroup>
			<_CohesionDatabaseRecordedArtifact Include="$(CohesionDatabaseSchemaOutputDirectory)%(_CohesionDatabaseRecordedSchema.Identity).schema.json" />
			<_CohesionDatabaseRecordedArtifact Include="$(CohesionDatabaseSchemaOutputDirectory)%(_CohesionDatabaseRecordedSchema.Identity).schema.sha256" />
			<_CohesionDatabaseMissingArtifact Include="@(_CohesionDatabaseRecordedArtifact)" Condition="!Exists('%(_CohesionDatabaseRecordedArtifact.FullPath)')" />
		</ItemGroup>
		<Delete Files="$(_CohesionDatabaseSchemaManifest)" Condition="'@(_CohesionDatabaseMissingArtifact)' != ''" />
	</Target>

	<!--
		The model target statically analyzes the retained C# schema declarations, one
		per database: SqlSchema.Create/Compile, or SqlDatabaseBuilder.Schema inside the
		engine builder's AddDatabase. It runs after references resolve and before C#
		compilation, so invalid schemas fail the ordinary Build without executing the
		consumer entry point. Whether the model target ran or was up to date, each
		database the manifest lists becomes a CohesionDatabaseSchema item (its schema
		document) for downstream targets, with DatabaseName and HashPath metadata.
	-->
	<Target
		Name="CohesionDatabaseCompileSchema"
		BeforeTargets="CoreCompile"
		Condition="'$(CohesionDatabaseProject)' == 'true'"
		DependsOnTargets="ResolveReferences;_CohesionDatabaseValidateModel;_CohesionDatabaseCheckSchemaArtifacts;$(_CohesionDatabaseModelCompileTarget)">
		<ReadLinesFromFile File="$(_CohesionDatabaseSchemaManifest)" Condition="Exists('$(_CohesionDatabaseSchemaManifest)')">
			<Output TaskParameter="Lines" ItemName="_CohesionDatabaseDeclaredSchema" />
		</ReadLinesFromFile>
		<PropertyGroup>
			<_CohesionDatabaseSchemaFullDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(CohesionDatabaseSchemaOutputDirectory)'))</_CohesionDatabaseSchemaFullDirectory>
		</PropertyGroup>
		<ItemGroup>
			<CohesionDatabaseSchema Remove="@(CohesionDatabaseSchema)" />
			<CohesionDatabaseSchema Include="$(_CohesionDatabaseSchemaFullDirectory)%(_CohesionDatabaseDeclaredSchema.Identity).schema.json">
				<DatabaseName>%(_CohesionDatabaseDeclaredSchema.Identity)</DatabaseName>
				<HashPath>$(_CohesionDatabaseSchemaFullDirectory)%(_CohesionDatabaseDeclaredSchema.Identity).schema.sha256</HashPath>
			</CohesionDatabaseSchema>
			<FileWrites Include="@(CohesionDatabaseSchema);@(CohesionDatabaseSchema->'%(HashPath)');$(_CohesionDatabaseSchemaManifest)" />
		</ItemGroup>
	</Target>

    <!--
        Opt-in migration generation for one declared database: diffs its compiled
        schema against the newest baseline under
        $(CohesionDatabaseMigrationsRoot)/<database>/ and emits an ordered migration
        script. Invoke explicitly:

            dotnet msbuild -t:CohesionDatabaseCreateMigration -p:CohesionDatabaseName=<database> -p:CohesionDatabaseMigrationName=<name>
    -->
	<Target
		Name="CohesionDatabaseCreateMigration"
		DependsOnTargets="CohesionDatabaseCompileSchema"
		Condition="'$(CohesionDatabaseProject)' == 'true'">

        <CreateDatabaseMigrationTask
            SchemaDirectory="$(CohesionDatabaseSchemaOutputDirectory)"
            DatabaseName="$(CohesionDatabaseName)"
            MigrationsRoot="$(CohesionDatabaseMigrationsRoot)"
            MigrationName="$(CohesionDatabaseMigrationName)"
			Model="$(CohesionDatabaseModel)"
			ProjectDirectory="$(MSBuildProjectDirectory)" />
	</Target>
</Project>
