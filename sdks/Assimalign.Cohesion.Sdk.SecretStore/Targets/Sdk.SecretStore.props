<Project>
	<!--
		Area orchestration defaults use Include so a consuming project can override
		a named item with Update, for example:
		<CohesionEndpoint Update="api" Public="true" />.
		The resource's domain composition remains in its Program.cs.
	-->
	<PropertyGroup>
		<CohesionResourceApplicationModel Condition="'$(CohesionResourceApplicationModel)' == ''">Assimalign.Cohesion.SecretStore.ApplicationModel</CohesionResourceApplicationModel>
		<CohesionResourceControlPlaneType Condition="'$(CohesionResourceControlPlaneType)' == ''">Assimalign.Cohesion.ApplicationModel.SecretStoreResourceControlPlane</CohesionResourceControlPlaneType>
		<CohesionResourceKind Condition="'$(CohesionResourceKind)' == ''">SecretStore</CohesionResourceKind>
		<CohesionControlPlaneEndpoint Condition="'$(CohesionControlPlaneEndpoint)' == ''">api</CohesionControlPlaneEndpoint>
		<CohesionControlPlanePath Condition="'$(CohesionControlPlanePath)' == ''">/cohesion/v1</CohesionControlPlanePath>
		<CohesionWorkloadKind Condition="'$(CohesionWorkloadKind)' == ''">StatefulSet</CohesionWorkloadKind>
		<CohesionMaxReplicas Condition="'$(CohesionMaxReplicas)' == ''">1</CohesionMaxReplicas>
	</PropertyGroup>

	<ItemGroup>
		<!-- add-secret carries a source expression (parameter:<name> or <store>:<key>) that the delivering
		     gateway must resolve; the store accepts only the resolved value, so the declaring gateway
		     must register an input resolver (UseSecretStore) and Build() fails without one. -->
		<CohesionCommand Include="secretstore.add-secret" RequiresInputResolver="true" />
		<CohesionCommand Include="secretstore.issue-certificate" />
		<CohesionEndpoint Include="api" Scheme="https" Certificate="tls" ContainerPort="8443" Public="false" />
		<CohesionMount Include="tls" Kind="Secret" ContainerPath="/cohesion/mounts/tls" />
		<CohesionMount Include="data" Kind="Volume" ContainerPath="/data" Size="10Gi" />
	</ItemGroup>
</Project>
