<Project Sdk="Assimalign.Cohesion.Sdk.Database">
  <PropertyGroup>
    <RootNamespace>Database</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <CohesionApplicationModel>enabled</CohesionApplicationModel>
    <CohesionApplication>gateway-smoke</CohesionApplication>
    <CohesionResourceName>gateway-smoke-database</CohesionResourceName>
  </PropertyGroup>
</Project>
