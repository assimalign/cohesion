<Project Sdk="Assimalign.Cohesion.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Web</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <CohesionApplicationModel>enabled</CohesionApplicationModel>
    <CohesionApplication>gateway-smoke</CohesionApplication>
    <CohesionResourceName>gateway-smoke-web</CohesionResourceName>
  </PropertyGroup>
  <ItemGroup>
    <CohesionResourceReference Include="..\Database\Database.csproj" Endpoints="db" />
  </ItemGroup>
</Project>
