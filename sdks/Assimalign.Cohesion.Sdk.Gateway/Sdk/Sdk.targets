<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<!--
		A gateway that hosts its resources in process references each resource's Sdk.<Area>
		project. Resource executables default to self-contained for the host runtime identifier
		(the base Sdk.targets), and their App and App.<Area> framework references flow to the
		gateway transitively. Those frameworks ship only as NuGet runtime packs, so a
		framework-dependent gateway would fail NETSDK1151 at build and, with that check off, fail
		at start with "Framework: 'Assimalign.Cohesion.App' ... No frameworks were found." The
		gateway therefore takes the same defaults a resource executable does, without the
		resource-SDK marker that adds the App framework. A project that sets SelfContained or
		RuntimeIdentifier keeps its own values. These must precede the base Sdk.targets, which
		imports Microsoft.NET.Sdk's Sdk.targets, the consumer of these properties.
	-->
	<PropertyGroup Condition="'$(OutputType)' == 'Exe'">
		<SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(SelfContained)' == 'true'">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
		<ValidateExecutableReferencesMatchSelfContained Condition="'$(ValidateExecutableReferencesMatchSelfContained)' == ''">false</ValidateExecutableReferencesMatchSelfContained>
	</PropertyGroup>

	<Import Sdk="Assimalign.Cohesion.Sdk" Project="Sdk.targets" />
	<Import Project="..\Targets\Sdk.Gateway.targets" />
</Project>
