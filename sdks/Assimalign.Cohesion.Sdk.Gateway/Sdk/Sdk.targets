<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<!--
		These values are deliberately forced after the consuming project has been
		evaluated and before the base resource targets compute their enabled state.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<CohesionApplicationModel>enabled</CohesionApplicationModel>
		<CohesionResourceKind>Composite</CohesionResourceKind>
		<CohesionResourceApplicationModel>Assimalign.Cohesion.ApplicationModel.Gateway.ControlPlane</CohesionResourceApplicationModel>
		<_CohesionGatewayInProcessSelected>$([System.Text.RegularExpressions.Regex]::IsMatch('$(CohesionGateways)', '(^|;)\s*InProcess\s*(;|$)', System.Text.RegularExpressions.RegexOptions.IgnoreCase))</_CohesionGatewayInProcessSelected>
		<_CohesionGatewayDockerSelected>$([System.Text.RegularExpressions.Regex]::IsMatch('$(CohesionGateways)', '(^|;)\s*Docker\s*(;|$)', System.Text.RegularExpressions.RegexOptions.IgnoreCase))</_CohesionGatewayDockerSelected>
		<_CohesionGatewayKubernetesSelected>$([System.Text.RegularExpressions.Regex]::IsMatch('$(CohesionGateways)', '(^|;)\s*Kubernetes\s*(;|$)', System.Text.RegularExpressions.RegexOptions.IgnoreCase))</_CohesionGatewayKubernetesSelected>
		<_CohesionGatewayInProcessActive Condition="'$(_CohesionGatewayInProcessSelected)' == 'True' and '$(CohesionGatewayInProcess)' == 'true'">true</_CohesionGatewayInProcessActive>
		<_CohesionGatewayInProcessActive Condition="'$(_CohesionGatewayInProcessActive)' == ''">false</_CohesionGatewayInProcessActive>
		<CohesionResourceReferencesAreRuntime>$(_CohesionGatewayInProcessActive)</CohesionResourceReferencesAreRuntime>
		<ValidateExecutableReferencesMatchSelfContained Condition="'$(_CohesionGatewayInProcessActive)' == 'true'">false</ValidateExecutableReferencesMatchSelfContained>

		<_CohesionGatewayInProcessProject>$(CohesionRepositoryDirectory)libraries\ApplicationModel\Assimalign.Cohesion.ApplicationModel.Gateway.InProcess\src\Assimalign.Cohesion.ApplicationModel.Gateway.InProcess.csproj</_CohesionGatewayInProcessProject>
		<_CohesionGatewayControlPlaneProject>$(CohesionRepositoryDirectory)libraries\ApplicationModel\Assimalign.Cohesion.ApplicationModel.Gateway.ControlPlane\src\Assimalign.Cohesion.ApplicationModel.Gateway.ControlPlane.csproj</_CohesionGatewayControlPlaneProject>
	</PropertyGroup>

	<!--
		The areas a gateway composes are the areas of the resource projects it references.
		Each CohesionResourceReference project is read at evaluation time (restore sees the
		result on every engine, including Visual Studio's) and its Project Sdk attribute
		names the area: Assimalign.Cohesion.Sdk.Web is the Web area. A reference may state
		the area itself with Area metadata, which wins over the attribute; a project on the
		base SDK, a referenced gateway, a missing project, and a manifest package name no
		area. Those areas drive exactly two injections below: the area's ApplicationModel
		package, and, when the gateway hosts its members in process, the area's shared
		framework. Every other area package is the consumer's own explicit reference.
	-->
	<ItemGroup>
		<_CohesionGatewayReferencedProject Include="@(CohesionResourceReference->WithMetadataValue('Extension', '.csproj'))">
			<ProjectExists>$([System.IO.File]::Exists('%(FullPath)'))</ProjectExists>
		</_CohesionGatewayReferencedProject>
		<_CohesionGatewayReferencedProjectArea Include="@(_CohesionGatewayReferencedProject->WithMetadataValue('ProjectExists', 'True'))">
			<HasAreaSdk>$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), 'Project\s+Sdk\s*=\s*"Assimalign\.Cohesion\.Sdk\.[A-Za-z]+'))</HasAreaSdk>
		</_CohesionGatewayReferencedProjectArea>
		<_CohesionGatewayReferencedProjectArea Update="@(_CohesionGatewayReferencedProjectArea)">
			<Area Condition="'%(_CohesionGatewayReferencedProjectArea.Area)' == '' and '%(_CohesionGatewayReferencedProjectArea.HasAreaSdk)' == 'True'">$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('%(_CohesionGatewayReferencedProjectArea.FullPath)')), '(?s)^.*?Project\s+Sdk\s*=\s*"Assimalign\.Cohesion\.Sdk\.([A-Za-z]+).*$', '$1'))</Area>
		</_CohesionGatewayReferencedProjectArea>
	</ItemGroup>
	<PropertyGroup>
		<!-- The property round trip strips the probe metadata from the area names. -->
		<_CohesionGatewayReferencedAreas>@(_CohesionGatewayReferencedProjectArea->'%(Area)'->Distinct())</_CohesionGatewayReferencedAreas>
	</PropertyGroup>
	<ItemGroup>
		<_CohesionGatewayReferencedArea Include="$(_CohesionGatewayReferencedAreas)" Exclude="Gateway" />
		<_CohesionGatewayReferencedAreaModel Include="@(_CohesionGatewayReferencedArea)">
			<PackageId>Assimalign.Cohesion.%(Identity).ApplicationModel</PackageId>
			<ProjectPath>$(CohesionRepositoryDirectory)resources\%(Identity)\Assimalign.Cohesion.%(Identity).ApplicationModel\src\Assimalign.Cohesion.%(Identity).ApplicationModel.csproj</ProjectPath>
		</_CohesionGatewayReferencedAreaModel>
		<_CohesionGatewayReferencedAreaModel Update="@(_CohesionGatewayReferencedAreaModel)">
			<ProjectExists Condition="'$(CohesionRepositoryDirectory)' != ''">$([System.IO.File]::Exists('%(_CohesionGatewayReferencedAreaModel.ProjectPath)'))</ProjectExists>
			<ProjectExists Condition="'$(CohesionRepositoryDirectory)' == ''">False</ProjectExists>
		</_CohesionGatewayReferencedAreaModel>
	</ItemGroup>
	<PropertyGroup>
		<_CohesionGatewayReferencedAreaFrameworks>@(_CohesionGatewayReferencedArea->'Assimalign.Cohesion.App.%(Identity)')</_CohesionGatewayReferencedAreaFrameworks>
	</PropertyGroup>

	<!--
		The three store clients stay restore-visible for every gateway: mount sources and
		command targets can name a protected store from another application that no
		referenced project introduces, and CohesionCreateResourceVerbs reports the exact
		manifest-derived client set for validation. T11's restore-visible producer
		descriptor remains the future contract for them.
	-->
	<ItemGroup>
		<!-- Refresh metadata whose consumer-facing properties are set after Sdk.props. -->
		<CohesionEndpoint Update="admin" ContainerPort="$(CohesionGatewayAdminPort)" />
		<CohesionGatewayPackage Update="Local;InProcess" Version="$(CohesionVersion)" />
		<CohesionGatewayPackage Update="Docker;Kubernetes" Version="$(CohesionPlatformsVersion)" />
		<CohesionResourceProperty Include="composite.applicationSet" Value="true" Condition="'$(CohesionIsApplicationSet)' == 'true'" />

		<_CohesionGatewayInProcessPackage Include="@(CohesionGatewayPackage->WithMetadataValue('Identity', 'InProcess'))" />
		<_CohesionGatewayDockerPackage Include="@(CohesionGatewayPackage->WithMetadataValue('Identity', 'Docker'))" />
		<_CohesionGatewayKubernetesPackage Include="@(CohesionGatewayPackage->WithMetadataValue('Identity', 'Kubernetes'))" />

		<!-- Referenced areas: the area's ApplicationModel, as a repository project or the frozen package. -->
		<CohesionProjectReference
			Include="@(_CohesionGatewayReferencedAreaModel->WithMetadataValue('ProjectExists', 'True')->'%(PackageId)')"
			Condition="'$(CohesionRepositoryDirectory)' != ''" />
		<CohesionPackageReference
			Include="@(_CohesionGatewayReferencedAreaModel->WithMetadataValue('ProjectExists', 'False')->'%(PackageId)')"
			Version="$(CohesionVersion)" />

		<_CohesionGatewaySecretStoreClientProject Include="$(CohesionRepositoryDirectory)resources\SecretStore\Assimalign.Cohesion.SecretStore.Client\src\Assimalign.Cohesion.SecretStore.Client.csproj" Condition="Exists('$(CohesionRepositoryDirectory)resources\SecretStore\Assimalign.Cohesion.SecretStore.Client\src\Assimalign.Cohesion.SecretStore.Client.csproj')" />
		<_CohesionGatewayConfigurationStoreClientProject Include="$(CohesionRepositoryDirectory)resources\ConfigurationStore\Assimalign.Cohesion.ConfigurationStore.Client\src\Assimalign.Cohesion.ConfigurationStore.Client.csproj" Condition="Exists('$(CohesionRepositoryDirectory)resources\ConfigurationStore\Assimalign.Cohesion.ConfigurationStore.Client\src\Assimalign.Cohesion.ConfigurationStore.Client.csproj')" />
		<_CohesionGatewayDatabaseClientProject Include="$(CohesionRepositoryDirectory)resources\Database\Assimalign.Cohesion.Database.Client\src\Assimalign.Cohesion.Database.Client.csproj" Condition="Exists('$(CohesionRepositoryDirectory)resources\Database\Assimalign.Cohesion.Database.Client\src\Assimalign.Cohesion.Database.Client.csproj')" />

		<CohesionProjectReference Include="Assimalign.Cohesion.SecretStore.Client" ProjectPath="@(_CohesionGatewaySecretStoreClientProject)" Condition="'@(_CohesionGatewaySecretStoreClientProject)' != ''" />
		<CohesionProjectReference Include="Assimalign.Cohesion.ConfigurationStore.Client" ProjectPath="@(_CohesionGatewayConfigurationStoreClientProject)" Condition="'@(_CohesionGatewayConfigurationStoreClientProject)' != ''" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Client" ProjectPath="@(_CohesionGatewayDatabaseClientProject)" Condition="'@(_CohesionGatewayDatabaseClientProject)' != ''" />
		<CohesionPackageReference Include="Assimalign.Cohesion.SecretStore.Client" Version="$(CohesionVersion)" Condition="'@(_CohesionGatewaySecretStoreClientProject)' == ''" />
		<CohesionPackageReference Include="Assimalign.Cohesion.ConfigurationStore.Client" Version="$(CohesionVersion)" Condition="'@(_CohesionGatewayConfigurationStoreClientProject)' == ''" />
		<CohesionPackageReference Include="Assimalign.Cohesion.Database.Client" Version="$(CohesionVersion)" Condition="'@(_CohesionGatewayDatabaseClientProject)' == ''" />

		<CohesionProjectReference Include="Assimalign.Cohesion.ApplicationModel.Gateway.ControlPlane" ProjectPath="$(_CohesionGatewayControlPlaneProject)" Condition="'$(CohesionRepositoryDirectory)' != ''" />
		<CohesionPackageReference Include="Assimalign.Cohesion.ApplicationModel.Gateway.ControlPlane" Version="$(CohesionVersion)" Condition="'$(CohesionRepositoryDirectory)' == ''" />
		<CohesionProjectReference Include="Assimalign.Cohesion.ApplicationModel.Gateway.InProcess" ProjectPath="$(_CohesionGatewayInProcessProject)" Condition="'$(_CohesionGatewayInProcessSelected)' == 'True' and '$(CohesionRepositoryDirectory)' != ''" />
		<CohesionPackageReference Include="@(_CohesionGatewayInProcessPackage->'%(PackageId)')" Version="@(_CohesionGatewayInProcessPackage->'%(Version)')" Condition="'$(_CohesionGatewayInProcessSelected)' == 'True' and '$(CohesionRepositoryDirectory)' == ''" />

		<CohesionPackageReference Include="@(_CohesionGatewayDockerPackage->'%(PackageId)')" Version="@(_CohesionGatewayDockerPackage->'%(Version)')" Condition="'$(_CohesionGatewayDockerSelected)' == 'True'" />
		<CohesionPackageReference Include="@(_CohesionGatewayKubernetesPackage->'%(PackageId)')" Version="@(_CohesionGatewayKubernetesPackage->'%(Version)')" Condition="'$(_CohesionGatewayKubernetesSelected)' == 'True'" />

		<!--
			In process, the gateway compiles against and ships the members' frameworks:
			the base App framework plus App.<Area> for every referenced area. A manifest-only
			gateway references no framework at all (T11: no App.Gateway).
		-->
		<FrameworkReference Include="Assimalign.Cohesion.App" Condition="'$(_CohesionGatewayInProcessActive)' == 'true'" />
		<FrameworkReference Include="$(_CohesionGatewayReferencedAreaFrameworks)" Condition="'$(_CohesionGatewayInProcessActive)' == 'true' and '$(_CohesionGatewayReferencedAreaFrameworks)' != ''" />
	</ItemGroup>

	<!-- Repository builds import the optional provider only after consumer properties are known. -->
	<Import
		Project="$(CohesionRepositoryDirectory)libraries\ApplicationModel\Assimalign.Cohesion.ApplicationModel.Gateway.InProcess\buildTransitive\Assimalign.Cohesion.ApplicationModel.Gateway.InProcess.props"
		Condition="'$(_CohesionGatewayInProcessSelected)' == 'True' and '$(CohesionRepositoryDirectory)' != '' and Exists('$(CohesionRepositoryDirectory)libraries\ApplicationModel\Assimalign.Cohesion.ApplicationModel.Gateway.InProcess\buildTransitive\Assimalign.Cohesion.ApplicationModel.Gateway.InProcess.props')" />

	<!--
		NativeAOT targets must be selected before the base SDK targets latch trim/self-contained
		state. Items are not available during property evaluation, so auto-selection is enabled
		early only for the two known AOT-safe cohesion providers. The target-time provider pass
		below remains authoritative for contributed providers and never pre-enables trimming for
		an unknown or RequiresJit provider.
	-->
	<PropertyGroup>
		<_CohesionGatewayAutoAotKnownSafe>$([System.Text.RegularExpressions.Regex]::IsMatch('$(CohesionGateways)', '^\s*(Local|InProcess)(\s*;\s*(Local|InProcess))*\s*$', System.Text.RegularExpressions.RegexOptions.IgnoreCase))</_CohesionGatewayAutoAotKnownSafe>
		<PublishAot Condition="'$(CohesionGatewayAot)' == 'true'">true</PublishAot>
		<PublishAot Condition="'$(CohesionGatewayAot)' == 'false'">false</PublishAot>
		<PublishAot Condition="'$(CohesionGatewayAot)' == 'auto' and '$(_CohesionGatewayAutoAotKnownSafe)' == 'True'">true</PublishAot>
	</PropertyGroup>

	<Import Sdk="Assimalign.Cohesion.Sdk" Project="Sdk.targets" />
	<Import Project="..\Targets\Sdk.Gateway.targets" />
</Project>
