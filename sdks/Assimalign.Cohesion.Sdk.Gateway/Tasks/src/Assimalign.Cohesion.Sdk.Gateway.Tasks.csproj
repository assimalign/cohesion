<Project Sdk="Microsoft.NET.Sdk">
	<!--
		The slim Gateway SDK ships props and targets only and runs no MSBuild task. This project
		exists to pack Sdk/ and Targets/ (sdks/Directory.Build.targets), so it takes no MSBuild
		package reference and packs no Tasks/ payload.
	-->
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Sdk.Gateway.Tasks</RootNamespace>
		<PackageId>Assimalign.Cohesion.Sdk.Gateway</PackageId>
		<OutDir>$(CohesionOutputPathForSdk)\$(NETCoreSdkVersion)\sdks\$(PackageId)\Tasks</OutDir>
		<CohesionSdkPackTasks>false</CohesionSdkPackTasks>
	</PropertyGroup>
</Project>
