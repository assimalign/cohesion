<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Assimalign.Cohesion.Sdk.Gateway.Tests</RootNamespace>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Selects the Gateway variant of the base SDK's package-boundary workspace. -->
    <DefineConstants>$(DefineConstants);COHESION_GATEWAY_SDK_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <CohesionPackageReference Include="coverlet.collector" />
    <CohesionPackageReference Include="Microsoft.NET.Test.Sdk" />
    <CohesionPackageReference Include="Shouldly" />
    <CohesionPackageReference Include="xunit" />
    <CohesionPackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TestProjects\**\*.cs" />
    <Compile Include="..\..\..\Assimalign.Cohesion.Sdk\Tasks\tests\ConsumerWorkspace.cs" Link="TestObjects\ConsumerWorkspace.cs" />
    <Compile Include="..\..\..\Assimalign.Cohesion.Sdk\Tasks\tests\DotNetBuildResult.cs" Link="TestObjects\DotNetBuildResult.cs" />
  </ItemGroup>

</Project>
