<Project>
	<!--
		The gateway's one implicit reference: the gateway package at $(CohesionVersion). That
		property comes from the base Assimalign.Cohesion.Sdk's frozen Build.Version.props, which
		Sdk.props imports first, not from this SDK's own copy; a consumer pins both SDKs to the
		same version in global.json, so the two agree. The package brings the model definitions,
		the protocol and the shared identity with it. The gateway's Program.cs declares its model
		and builds the gateway with ApplicationGateway.CreateBuilder(name); nothing is generated.

		Platforms are explicit: the project references the gateway half of each platform it runs
		on (Assimalign.Cohesion.ApplicationModel.Gateway.InProcess, or a cohesion-platforms package
		such as Assimalign.Cohesion.ApplicationModel.Gateway.Kubernetes) and registers it on the
		builder.

		CohesionGatewayImplicitReference=false turns the reference off, for a project that pins the
		gateway package itself.
	-->
	<ItemGroup Condition="'$(CohesionGatewayImplicitReference)' != 'false'">
		<PackageReference Include="Assimalign.Cohesion.ApplicationModel.Gateway" Version="$(CohesionVersion)" IsImplicitlyDefined="true" />
	</ItemGroup>
</Project>
