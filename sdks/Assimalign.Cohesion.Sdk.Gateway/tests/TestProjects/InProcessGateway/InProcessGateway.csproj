<Project Sdk="Assimalign.Cohesion.Sdk.Gateway">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <IsAotCompatible>true</IsAotCompatible>
    <CohesionApplicationName>inprocess-guard</CohesionApplicationName>
    <CohesionResourceName>inprocess-guard-gateway</CohesionResourceName>
    <CohesionGateways>Local</CohesionGateways>
    <CohesionGatewayInProcess>true</CohesionGatewayInProcess>
  </PropertyGroup>

</Project>
