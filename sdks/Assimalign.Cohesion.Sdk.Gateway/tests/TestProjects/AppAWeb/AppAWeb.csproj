<Project Sdk="Assimalign.Cohesion.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <IsAotCompatible>true</IsAotCompatible>
    <CohesionApplicationModel>enabled</CohesionApplicationModel>
    <CohesionApplication>appa</CohesionApplication>
    <CohesionResourceName>appa-web</CohesionResourceName>
  </PropertyGroup>

  <ItemGroup>
    <CohesionResourceReference Include="..\PlatformDatabase\PlatformDatabase.csproj" Endpoints="db" />
  </ItemGroup>

</Project>
