<Project>
	<!--
		Area orchestration defaults use Include so a consuming project can override
		a named item with Update, for example:
		<CohesionEndpoint Update="api" Public="true" />.
		The resource's domain composition remains in its Program.cs.
	-->
	<PropertyGroup>
		<CohesionResourceApplicationModel Condition="'$(CohesionResourceApplicationModel)' == ''">Assimalign.Cohesion.ConfigurationStore.ApplicationModel</CohesionResourceApplicationModel>
		<CohesionResourceControlPlaneType Condition="'$(CohesionResourceControlPlaneType)' == ''">Assimalign.Cohesion.ApplicationModel.ConfigurationStoreResourceControlPlane</CohesionResourceControlPlaneType>
		<CohesionResourceKind Condition="'$(CohesionResourceKind)' == ''">ConfigurationStore</CohesionResourceKind>
		<CohesionControlPlaneEndpoint Condition="'$(CohesionControlPlaneEndpoint)' == ''">api</CohesionControlPlaneEndpoint>
		<CohesionControlPlanePath Condition="'$(CohesionControlPlanePath)' == ''">/cohesion/v1</CohesionControlPlanePath>
		<CohesionWorkloadKind Condition="'$(CohesionWorkloadKind)' == ''">StatefulSet</CohesionWorkloadKind>
		<CohesionMaxReplicas Condition="'$(CohesionMaxReplicas)' == ''">1</CohesionMaxReplicas>
	</PropertyGroup>

	<ItemGroup>
		<CohesionCommand Include="configurationstore.add-namespace;configurationstore.set-value;configurationstore.remove-value" />
		<CohesionEndpoint Include="api" Scheme="https" Certificate="tls" ContainerPort="8443" Public="false" />
		<CohesionMount Include="tls" Kind="Secret" ContainerPath="/cohesion/mounts/tls" />
		<CohesionMount Include="data" Kind="Volume" ContainerPath="/data" Size="10Gi" />
	</ItemGroup>
</Project>
