<Project>
	<PropertyGroup>
		<CohesionApplication Condition="'$(CohesionApplication)' == '' and '$(CohesionApplicationName)' != ''">$(CohesionApplicationName)</CohesionApplication>
		<CohesionApplicationName Condition="'$(CohesionApplicationName)' == '' and '$(CohesionApplication)' != ''">$(CohesionApplication)</CohesionApplicationName>
		<_CohesionResourceEnabled Condition="'$(CohesionApplicationModel)' == 'enabled'">true</_CohesionResourceEnabled>
		<_CohesionGetManifestDependsOn Condition="'$(_CohesionResourceEnabled)' == 'true'">CohesionCreateResourceManifest</_CohesionGetManifestDependsOn>
		<_CohesionOutputTypeLower>$([System.String]::Copy('$(OutputType)').ToLowerInvariant())</_CohesionOutputTypeLower>

		<_CohesionResolvedResourceKind>$([System.String]::Copy('$(CohesionResourceKind)').Trim())</_CohesionResolvedResourceKind>
		<_CohesionResourceNameSeed Condition="'$(CohesionResourceName)' == ''">$([System.Text.RegularExpressions.Regex]::Replace('$(MSBuildProjectName)', '^[^.]+\.', ''))</_CohesionResourceNameSeed>
		<_CohesionResourceNameSeed Condition="'$(CohesionResourceName)' != ''">$([System.String]::Copy('$(CohesionResourceName)').Trim())</_CohesionResourceNameSeed>
		<_CohesionResourceNameLower>$([System.String]::Copy('$(_CohesionResourceNameSeed)').ToLowerInvariant())</_CohesionResourceNameLower>
		<_CohesionResourceNameSlug>$([System.Text.RegularExpressions.Regex]::Replace('$(_CohesionResourceNameLower)', '[^a-z0-9]+', '-'))</_CohesionResourceNameSlug>
		<_CohesionResolvedResourceName Condition="'$(CohesionResourceName)' == ''">$([System.String]::Copy('$(_CohesionResourceNameSlug)').Trim('-'))</_CohesionResolvedResourceName>
		<_CohesionResolvedResourceName Condition="'$(CohesionResourceName)' != ''">$(_CohesionResourceNameSeed)</_CohesionResolvedResourceName>

		<_CohesionProjectNameHasTwoSegments>$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '^[^.]+\.[^.]+$'))</_CohesionProjectNameHasTwoSegments>
		<_CohesionProjectNameHasThreeOrMoreSegments>$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '^[^.]+\.[^.]+\..+$'))</_CohesionProjectNameHasThreeOrMoreSegments>
		<_CohesionApplicationSeed Condition="'$(CohesionApplication)' != ''">$([System.String]::Copy('$(CohesionApplication)').Trim())</_CohesionApplicationSeed>
		<_CohesionApplicationSeed Condition="'$(CohesionApplication)' == '' and '$(_CohesionProjectNameHasTwoSegments)' == 'True'">$([System.Text.RegularExpressions.Regex]::Replace('$(MSBuildProjectName)', '^([^.]+)\.[^.]+$', '$1'))</_CohesionApplicationSeed>
		<_CohesionApplicationSeed Condition="'$(CohesionApplication)' == '' and '$(_CohesionProjectNameHasThreeOrMoreSegments)' == 'True'">$([System.Text.RegularExpressions.Regex]::Replace('$(MSBuildProjectName)', '^[^.]+\.([^.]+)\..+$', '$1'))</_CohesionApplicationSeed>
		<_CohesionApplicationSeed Condition="'$(_CohesionApplicationSeed)' == ''">$(MSBuildProjectName)</_CohesionApplicationSeed>
		<_CohesionApplicationLower>$([System.String]::Copy('$(_CohesionApplicationSeed)').ToLowerInvariant())</_CohesionApplicationLower>
		<_CohesionApplicationSlug>$([System.Text.RegularExpressions.Regex]::Replace('$(_CohesionApplicationLower)', '[^a-z0-9]+', '-'))</_CohesionApplicationSlug>
		<_CohesionResolvedApplicationName>$([System.String]::Copy('$(_CohesionApplicationSlug)').Trim('-'))</_CohesionResolvedApplicationName>

		<CohesionResourceManifestPath Condition="'$(CohesionResourceManifestPath)' == ''">$(IntermediateOutputPath)cohesion/resource.json</CohesionResourceManifestPath>
		<CohesionResourceSourcePath Condition="'$(CohesionResourceSourcePath)' == ''">$(IntermediateOutputPath)cohesion/Resource.g.cs</CohesionResourceSourcePath>
		<CohesionResourceControlPlaneSourcePath Condition="'$(CohesionResourceControlPlaneSourcePath)' == ''">$(IntermediateOutputPath)cohesion/ResourceControlPlane.g.cs</CohesionResourceControlPlaneSourcePath>
		<CohesionImageManifestPath Condition="'$(CohesionImageManifestPath)' == ''">$(IntermediateOutputPath)cohesion/image.json</CohesionImageManifestPath>
		<CohesionPackResourceManifestPath Condition="'$(CohesionPackResourceManifestPath)' == ''">$(IntermediateOutputPath)cohesion/pack/resource.json</CohesionPackResourceManifestPath>
		<_CohesionResourceManifestFullPath>$([System.IO.Path]::GetFullPath('$(CohesionResourceManifestPath)', '$(MSBuildProjectDirectory)'))</_CohesionResourceManifestFullPath>

		<_CohesionPackManifest Condition="'$(_CohesionResourceEnabled)' == 'true' and '$(_CohesionRuntimePack)' != 'true'">true</_CohesionPackManifest>
		<CohesionManifestPackageId Condition="'$(CohesionManifestPackageId)' == ''">$(AssemblyName).Manifest</CohesionManifestPackageId>
		<PackageId Condition="'$(_CohesionPackManifest)' == 'true'">$(CohesionManifestPackageId)</PackageId>
		<PackageType Condition="'$(_CohesionPackManifest)' == 'true'">CohesionResourceManifest</PackageType>
		<PackageReadmeFile Condition="'$(_CohesionPackManifest)' == 'true'">README.md</PackageReadmeFile>
		<IncludeBuildOutput Condition="'$(_CohesionPackManifest)' == 'true'">false</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking Condition="'$(_CohesionPackManifest)' == 'true'">true</SuppressDependenciesWhenPacking>
		<TargetsForTfmSpecificContentInPackage Condition="'$(_CohesionPackManifest)' == 'true'">$(TargetsForTfmSpecificContentInPackage);CohesionPackManifest</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<!--
		An enabled resource executable is its composition root, so it receives the
		area's ApplicationModel package. Repository builds keep the dependency as a
		name-only CohesionProjectReference; packaged consumers receive the matching
		CohesionPackageReference at the SDK's frozen CohesionVersion. The base SDK's
		shared reference converter projects these canonical items after this target
		has evaluated.
	-->
	<ItemGroup Condition="'$(_CohesionResourceEnabled)' == 'true' and '$(CohesionResourceApplicationModel)' != '' and '$(CohesionSkipResourceApplicationModelReference)' != 'true'">
		<_CohesionResourceApplicationModelProject
			Include="$(CohesionRepositoryDirectory)resources\**\src\$(CohesionResourceApplicationModel).csproj"
			Condition="'$(CohesionRepositoryDirectory)' != ''" />

		<CohesionProjectReference
			Include="$(CohesionResourceApplicationModel)"
			Condition="'@(_CohesionResourceApplicationModelProject)' != ''">
			<ProjectPath>@(_CohesionResourceApplicationModelProject)</ProjectPath>
			<CohesionSdkApplicationModel>true</CohesionSdkApplicationModel>
		</CohesionProjectReference>

		<CohesionPackageReference
			Include="$(CohesionResourceApplicationModel)"
			Version="$(CohesionVersion)"
			Condition="'@(_CohesionResourceApplicationModelProject)' == ''">
			<CohesionSdkApplicationModel>true</CohesionSdkApplicationModel>
		</CohesionPackageReference>
	</ItemGroup>

	<ItemGroup Condition="'$(_CohesionPackManifest)' == 'true'">
		<FrameworkReference Update="Assimalign.Cohesion.App*" PrivateAssets="all" />
	</ItemGroup>

	<Target Name="CohesionValidateApplicationModel" BeforeTargets="PrepareForBuild;CoreCompile">
		<Error
			Condition="'$(CohesionApplicationModel)' != 'disabled' and '$(CohesionApplicationModel)' != 'enabled'"
			Text="CohesionApplicationModel must be 'disabled' or 'enabled'." />
		<Error
			Condition="'$(CohesionApplicationModel)' == 'enabled' and '$(_CohesionOutputTypeLower)' != 'exe'"
			Code="COHSDK008"
			File="$(MSBuildProjectFullPath)"
			Text="$(MSBuildProjectName) has CohesionApplicationModel enabled but OutputType is '$(OutputType)'; set OutputType to 'Exe'." />
	</Target>

	<ItemGroup Condition="'$(_CohesionResourceEnabled)' == 'true'">
		<_CohesionResourceProjectReference Include="@(CohesionResourceReference->WithMetadataValue('Extension', '.csproj'))" />
		<_CohesionResourcePackageReference Include="@(CohesionResourceReference)" Exclude="@(_CohesionResourceProjectReference)" />
		<ProjectReference
			Include="@(_CohesionResourceProjectReference)"
			ReferenceOutputAssembly="false"
			OutputItemType="CohesionResourceManifest"
			Condition="'$(CohesionResourceReferencesAreRuntime)' != 'true'" />
		<ProjectReference
			Include="@(_CohesionResourceProjectReference)"
			ReferenceOutputAssembly="true"
			Condition="'$(CohesionResourceReferencesAreRuntime)' == 'true'" />
		<PackageReference
			Include="@(_CohesionResourcePackageReference)"
			PrivateAssets="all" />

		<Compile Include="$(CohesionResourceSourcePath)" Link="Resource.g.cs" Visible="false" />
		<Compile Include="$(CohesionResourceControlPlaneSourcePath)" Link="ResourceControlPlane.g.cs" Visible="false" />
		<EmbeddedResource Include="$(CohesionResourceManifestPath)" LogicalName="cohesion/resource.json" Visible="false" />
		<ContainerLabel Include="org.cohesion.manifest" Value="cohesion/resource.json" />
		<CohesionResourceManifest Include="$(CohesionResourceManifestPath)" IsSelf="true" />
		<CohesionResourcePackAsset
			Include="$(CohesionPackResourceManifestPath)"
			PackagePath="cohesion/resource.json"
			Condition="'$(_CohesionPackManifest)' == 'true'" />
	</ItemGroup>

	<Target
		Name="CohesionResolveResourceReferences"
		AfterTargets="ResolveProjectReferences"
		Condition="'$(_CohesionResourceEnabled)' == 'true'">
		<MSBuild
			Projects="@(_CohesionResourceProjectReference)"
			Targets="CohesionGetManifest"
			BuildInParallel="$(BuildInParallel)"
			SkipNonexistentTargets="true"
			Condition="'@(_CohesionResourceProjectReference)' != ''">
			<Output TaskParameter="TargetOutputs" ItemName="_CohesionReferencedManifest" />
		</MSBuild>
	</Target>

	<Target
		Name="CohesionCreateResourceManifest"
		BeforeTargets="PrepareResourceNames;CoreCompile"
		DependsOnTargets="CohesionValidateApplicationModel;ResolveProjectReferences;CohesionResolveResourceReferences"
		Inputs="$(MSBuildProjectFullPath);$(MSBuildAllProjects);@(_CohesionReferencedManifest)"
		Outputs="$(CohesionResourceManifestPath);$(CohesionResourceSourcePath);$(CohesionResourceControlPlaneSourcePath)"
		Condition="'$(_CohesionResourceEnabled)' == 'true'">
		<CohesionCreateResourceManifest
			ManifestOutputPath="$(CohesionResourceManifestPath)"
			ResourceSourceOutputPath="$(CohesionResourceSourcePath)"
			ControlPlaneSourceOutputPath="$(CohesionResourceControlPlaneSourcePath)"
			ProjectFullPath="$(MSBuildProjectFullPath)"
			ProjectName="$(MSBuildProjectName)"
			RootNamespace="$(RootNamespace)"
			AssemblyName="$(AssemblyName)"
			OutputType="$(OutputType)"
			TargetPath="$(TargetPath)"
			AppHostPath="$(TargetDir)$(TargetName)$(_NativeExecutableExtension)"
			ResourceName="$(CohesionResourceName)"
			ResourceKind="$(CohesionResourceKind)"
			ApplicationName="$(CohesionApplication)"
			ApplicationModelName="$(CohesionResourceApplicationModel)"
			ControlPlaneType="$(CohesionResourceControlPlaneType)"
			Composable="$(CohesionResourceComposable)"
			ControlPlaneEndpoint="$(CohesionControlPlaneEndpoint)"
			ControlPlanePath="$(CohesionControlPlanePath)"
			WorkloadKind="$(CohesionWorkloadKind)"
			Replicas="$(CohesionReplicas)"
			MaxReplicas="$(CohesionMaxReplicas)"
			StopGraceSeconds="$(CohesionStopGraceSeconds)"
			RestartPolicy="$(CohesionRestartPolicy)"
			Endpoints="@(CohesionEndpoint)"
			Probes="@(CohesionProbe)"
			Mounts="@(CohesionMount)"
			Settings="@(CohesionSetting)"
			ResourceReferences="@(CohesionResourceReference)"
			ReferencedManifests="@(_CohesionReferencedManifest);@(CohesionResourceManifest)"
			ResourceProperties="@(CohesionResourceProperty)">
			<Output TaskParameter="ResolvedResourceName" PropertyName="_CohesionResolvedResourceName" />
			<Output TaskParameter="ResolvedApplicationName" PropertyName="_CohesionResolvedApplicationName" />
			<Output TaskParameter="ResolvedResourceKind" PropertyName="_CohesionResolvedResourceKind" />
		</CohesionCreateResourceManifest>

		<ItemGroup>
			<FileWrites Include="$(CohesionResourceManifestPath);$(CohesionResourceSourcePath);$(CohesionResourceControlPlaneSourcePath)" />
		</ItemGroup>
	</Target>

	<Target
		Name="CohesionValidateManifestPackageImage"
		Condition="'$(_CohesionPackManifest)' == 'true'">
		<CohesionValidateImageManifest ImageManifestPath="$(CohesionImageManifestPath)">
			<Output TaskParameter="HasDigestPinnedImage" PropertyName="_CohesionHasDigestPinnedImage" />
		</CohesionValidateImageManifest>
		<Warning
			Condition="'$(_CohesionHasDigestPinnedImage)' != 'true' and '$(CohesionImageRequired)' != 'true'"
			Code="COHSDK004"
			File="$(MSBuildProjectFullPath)"
			Text="$(MSBuildProjectName) is packing a Cohesion resource manifest without a digest-pinned image manifest at '$(CohesionImageManifestPath)'; the package will be manifest-only." />
		<Error
			Condition="'$(_CohesionHasDigestPinnedImage)' != 'true' and '$(CohesionImageRequired)' == 'true'"
			Code="COHSDK004"
			File="$(MSBuildProjectFullPath)"
			Text="$(MSBuildProjectName) requires a digest-pinned image before packing because CohesionImageRequired=true; '$(CohesionImageManifestPath)' is missing or does not contain a valid SHA-256 digest." />
	</Target>

	<Target
		Name="CohesionPackManifest"
		DependsOnTargets="CohesionCreateResourceManifest;CohesionValidateManifestPackageImage"
		Condition="'$(_CohesionPackManifest)' == 'true'">
		<CohesionPrepareResourceManifestPackage
			SourceManifestPath="$(CohesionResourceManifestPath)"
			PackageManifestPath="$(CohesionPackResourceManifestPath)" />

		<ItemGroup>
			<CohesionResourcePackAsset
				Include="$(CohesionImageManifestPath)"
				PackagePath="cohesion/image.json"
				Condition="Exists('$(CohesionImageManifestPath)')" />
			<CohesionResourcePackAsset
				Include="$(CohesionContainerArchiveOutputPath)"
				PackagePath="images/$([System.IO.Path]::GetFileName('$(CohesionContainerArchiveOutputPath)'))"
				Condition="'$(CohesionPackImageArchive)' == 'true' and '$(CohesionContainerArchiveOutputPath)' != '' and Exists('$(CohesionContainerArchiveOutputPath)')" />
			<TfmSpecificPackageFile Include="@(CohesionResourcePackAsset)" />
			<TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)Assimalign.Cohesion.Sdk.ResourceManifest.props">
				<PackagePath>buildTransitive/$(PackageId).props</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)RESOURCE_MANIFEST_README.md">
				<PackagePath>README.md</PackagePath>
			</TfmSpecificPackageFile>
			<FileWrites Include="$(CohesionPackResourceManifestPath)" />
		</ItemGroup>
	</Target>

	<Target
		Name="CohesionPackRuntimePackage"
		AfterTargets="Pack"
		Condition="'$(_CohesionPackManifest)' == 'true' and '$(CohesionPackRuntime)' == 'true'">
		<MSBuild
			Projects="$(MSBuildProjectFullPath)"
			Targets="Pack"
			BuildInParallel="false"
			Properties="_CohesionRuntimePack=true;CohesionPackRuntime=false;PackageId=$(AssemblyName);Configuration=$(Configuration);PackageOutputPath=$(PackageOutputPath)" />
	</Target>

	<Target
		Name="CohesionGetManifest"
		DependsOnTargets="CohesionValidateApplicationModel;$(_CohesionGetManifestDependsOn)"
		Returns="@(_CohesionGetManifestResult)">
		<ItemGroup>
			<_CohesionGetManifestResult
				Include="$(_CohesionResourceManifestFullPath)"
				Condition="'$(_CohesionResourceEnabled)' == 'true'">
				<ManifestPath>$(_CohesionResourceManifestFullPath)</ManifestPath>
				<ApplicationModel>enabled</ApplicationModel>
				<ProjectName>$(MSBuildProjectName)</ProjectName>
				<ProjectFullPath>$(MSBuildProjectFullPath)</ProjectFullPath>
				<TargetPath>$(TargetPath)</TargetPath>
				<AppHostPath>$(TargetDir)$(TargetName)$(_NativeExecutableExtension)</AppHostPath>
				<Application>$(_CohesionResolvedApplicationName)</Application>
				<Resource>$(_CohesionResolvedResourceName)</Resource>
				<Kind>$(_CohesionResolvedResourceKind)</Kind>
				<IsSelf>true</IsSelf>
			</_CohesionGetManifestResult>
			<_CohesionGetManifestResult
				Include="$(MSBuildProjectFullPath)"
				Condition="'$(_CohesionResourceEnabled)' != 'true'">
				<ApplicationModel>disabled</ApplicationModel>
				<ProjectName>$(MSBuildProjectName)</ProjectName>
				<ProjectFullPath>$(MSBuildProjectFullPath)</ProjectFullPath>
				<IsSelf>true</IsSelf>
			</_CohesionGetManifestResult>
			<_CohesionGetManifestResult
				Include="@(_CohesionReferencedManifest)"
				Condition="'$(_CohesionResourceEnabled)' == 'true'">
				<IsSelf>false</IsSelf>
			</_CohesionGetManifestResult>
		</ItemGroup>
	</Target>

	<Target Name="CohesionCleanResourceManifest" AfterTargets="Clean">
		<Delete Files="$(CohesionResourceManifestPath);$(CohesionResourceSourcePath);$(CohesionResourceControlPlaneSourcePath);$(CohesionPackResourceManifestPath)" />
	</Target>
</Project>
