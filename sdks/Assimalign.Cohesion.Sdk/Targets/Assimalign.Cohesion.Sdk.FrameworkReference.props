        <KnownFrameworkReference Include="Assimalign.Cohesion.App.NatGateway"
            TargetFramework="net10.0"
            RuntimeFrameworkName="Assimalign.Cohesion.App.NatGateway"
            DefaultRuntimeFrameworkVersion="$(CohesionAppFrameworkVersion)"
