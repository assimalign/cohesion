        <KnownFrameworkReference Include="Assimalign.Cohesion.App.Scheduler"
            TargetFramework="net10.0"
            RuntimeFrameworkName="Assimalign.Cohesion.App.Scheduler"
            DefaultRuntimeFrameworkVersion="$(CohesionAppFrameworkVersion)"
            LatestRuntimeFrameworkVersion="$(CohesionAppFrameworkVersion)"
            TargetingPackName="Assimalign.Cohesion.App.Scheduler.Ref"
            TargetingPackVersion="$(CohesionAppFrameworkVersion)"
            RuntimePackNamePatterns="Assimalign.Cohesion.App.Scheduler.Runtime.**RID**"
