<Project>
    <PropertyGroup Condition="'$(CohesionAppSettingsClass)' != ''">
        <CohesionAppSettingsNamespace Condition="'$(CohesionAppSettingsNamespace)' == ''">$(RootNamespace)</CohesionAppSettingsNamespace>
        <_StronglyTypedSettingsIntermediateOutputPath>$(IntermediateOutputPath)Cohesion</_StronglyTypedSettingsIntermediateOutputPath>
        <_StronglyTypedSettingsOutput>$(_StronglyTypedSettingsIntermediateOutputPath)\$(CohesionAppSettingsClass).generated.cs</_StronglyTypedSettingsOutput>
        <_StronglyTypedSettingsInputsCache>$(_StronglyTypedSettingsIntermediateOutputPath)\$(CohesionAppSettingsClass).generated.inputs</_StronglyTypedSettingsInputsCache>
        <_StronglyTypedSettingsTaskAssembly>$(MSBuildThisFileDirectory)..\Tasks\Assimalign.Cohesion.Sdk.Tasks.dll</_StronglyTypedSettingsTaskAssembly>
    </PropertyGroup>

    <!--
        The generated settings source is a build output: its Compile item is added by the
        target that produces it, so it is never an evaluation-time item under obj that
        Visual Studio would display.
    -->
    <ItemGroup Condition="'$(CohesionAppSettingsClass)' != ''">
        <_AppSettings Include="$(MSBuildProjectDirectory)\appsettings*.json" />
    </ItemGroup>

    <Target Name="_CollectStronglyTypedSettingsInputs"
            Condition="'$(CohesionAppSettingsClass)' != ''">
        <MakeDir Directories="$(_StronglyTypedSettingsIntermediateOutputPath)" />
        <ItemGroup>
            <_StronglyTypedSettingsInputLine Include="Class=$(CohesionAppSettingsClass)" />
            <_StronglyTypedSettingsInputLine Include="Namespace=$(CohesionAppSettingsNamespace)" />
            <_StronglyTypedSettingsInputLine Include="@(_AppSettings->'File=%(FullPath)')" />
        </ItemGroup>
        <WriteLinesToFile
            File="$(_StronglyTypedSettingsInputsCache)"
            Lines="@(_StronglyTypedSettingsInputLine)"
            Overwrite="true"
            WriteOnlyWhenDifferent="true" />
    </Target>

    <Target Name="_GeneratedStronglyTypedAppSettings"
            BeforeTargets="CoreCompile"
            Condition="'$(CohesionAppSettingsClass)' != ''"
            DependsOnTargets="_CollectStronglyTypedSettingsInputs"
            Inputs="$(_StronglyTypedSettingsInputsCache);@(_AppSettings);$(_StronglyTypedSettingsTaskAssembly)"
            Outputs="$(_StronglyTypedSettingsOutput)">
        <CreateStronglyTypedSettingsTask
            AppSettingsClass="$(CohesionAppSettingsClass)"
            AppSettingsNamespace="$(CohesionAppSettingsNamespace)"
            AppSettingsFiles="@(_AppSettings)"
            AppSettingsOutputPath="$(_StronglyTypedSettingsOutput)" />
        <ItemGroup>
            <Compile Include="$(_StronglyTypedSettingsOutput)" AutoGen="true" DesignTime="true" />
            <FileWrites Include="$(_StronglyTypedSettingsOutput);$(_StronglyTypedSettingsInputsCache)" />
        </ItemGroup>
    </Target>

    <!--
        CoreClean deletes the generated source with the other file writes; Clean then
        regenerates it so IntelliSense keeps the settings type between a clean and the
        next build.
    -->
    <Target Name="_RegenerateStronglyTypedAppSettingsAfterClean"
            AfterTargets="Clean"
            DependsOnTargets="_GeneratedStronglyTypedAppSettings"
            Condition="'$(CohesionAppSettingsClass)' != ''" />
</Project>
