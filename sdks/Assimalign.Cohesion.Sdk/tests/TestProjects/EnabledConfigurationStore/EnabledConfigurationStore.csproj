<Project Sdk="Assimalign.Cohesion.Sdk.ConfigurationStore">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>EnabledConfigurationStore</RootNamespace>
    <CohesionApplicationModel>enabled</CohesionApplicationModel>
    <CohesionApplication>inventory</CohesionApplication>
    <CohesionResourceName>inventory-configuration</CohesionResourceName>
  </PropertyGroup>
</Project>
