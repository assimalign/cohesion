<Project Sdk="Assimalign.Cohesion.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>StronglyTypedSettingsOptOut</RootNamespace>
  </PropertyGroup>

  <Target Name="CaptureCompileItems" AfterTargets="CoreCompile">
    <WriteLinesToFile
      File="$(BaseIntermediateOutputPath)compile-items.txt"
      Lines="@(Compile)"
      Overwrite="true" />
  </Target>

</Project>
