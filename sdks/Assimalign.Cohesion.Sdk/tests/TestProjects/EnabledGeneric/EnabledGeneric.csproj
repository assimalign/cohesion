<Project Sdk="Assimalign.Cohesion.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>EnabledGeneric</RootNamespace>
    <CohesionApplicationModel>enabled</CohesionApplicationModel>
    <CohesionApplication>inventory</CohesionApplication>
    <CohesionResourceName>inventory-worker</CohesionResourceName>
    <CohesionResourceKind>Worker</CohesionResourceKind>
    <CohesionControlPlaneEndpoint>http</CohesionControlPlaneEndpoint>
    <CohesionControlPlanePath>/cohesion/v1</CohesionControlPlanePath>
    <CohesionWorkloadKind>Deployment</CohesionWorkloadKind>
  </PropertyGroup>

  <ItemGroup>
    <CohesionEndpoint Include="http" Scheme="http" ContainerPort="8082" DevPort="18082" />
  </ItemGroup>

</Project>
