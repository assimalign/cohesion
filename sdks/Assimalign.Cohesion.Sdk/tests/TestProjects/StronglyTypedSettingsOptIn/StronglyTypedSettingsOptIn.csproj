<Project Sdk="Assimalign.Cohesion.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <IsAotCompatible>true</IsAotCompatible>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050</WarningsAsErrors>
    <RootNamespace>StronglyTypedSettingsOptIn</RootNamespace>
    <CohesionAppSettingsClass>CatalogSettings</CohesionAppSettingsClass>
  </PropertyGroup>

</Project>
