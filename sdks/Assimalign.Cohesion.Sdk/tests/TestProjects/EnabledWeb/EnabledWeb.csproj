<Project Sdk="Assimalign.Cohesion.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>EnabledWeb</RootNamespace>
    <CohesionApplicationModel>enabled</CohesionApplicationModel>
    <CohesionApplication>inventory</CohesionApplication>
    <CohesionResourceName>inventory-web</CohesionResourceName>
    <CohesionResourceKind>Web</CohesionResourceKind>
    <CohesionResourceApplicationModel>Assimalign.Cohesion.Web.ApplicationModel</CohesionResourceApplicationModel>
    <CohesionControlPlaneEndpoint>http</CohesionControlPlaneEndpoint>
    <CohesionControlPlanePath>/cohesion/v1</CohesionControlPlanePath>
  </PropertyGroup>

  <ItemGroup>
    <CohesionEndpoint Include="http" Scheme="http" ContainerPort="8080" DevPort="18080" />
    <CohesionMount Include="cache" Kind="Configuration" Source="parameter:cache-path" />
    <CohesionSetting Include="Orders:PageSize" Default="50" Type="int" />
    <CohesionResourceReference Include="..\EnabledDatabase\EnabledDatabase.csproj" Endpoints="db" />
    <CohesionResourceProperty Include="web.kind" Value="Api" />
  </ItemGroup>

</Project>
