<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >
	<!--
		Every Cohesion framework a project needs is explicit: resource-area SDKs add App and
		App.<Area>, a direct base-SDK consumer names its own framework references, and Gateway
		adds App plus its referenced areas only for in-process composition. No transitive
		framework reference therefore needs its own runtime-pack download. Without this, a
		RID-specific or self-contained restore downloads the runtime pack of every registered
		area.
	-->
	<PropertyGroup>
		<DisableTransitiveFrameworkReferenceDownloads Condition="'$(DisableTransitiveFrameworkReferenceDownloads)' == ''">true</DisableTransitiveFrameworkReferenceDownloads>
	</PropertyGroup>

	<!--
		A resource executable references the App and App.<Area> shared frameworks, which ship as
		NuGet runtime packs and are never installed under the dotnet root's shared/ folder. A
		framework-dependent resource executable therefore cannot start: the host reports
		"Framework: 'Assimalign.Cohesion.App' ... No frameworks were found." Resource executables
		default to self-contained for the host runtime identifier in plain and orchestrated mode
		alike (Sdk.ApplicationModel sets the same defaults for enabled projects before this
		import). A project that sets SelfContained or RuntimeIdentifier keeps its own values.
		These must precede Microsoft.NET.Sdk's Sdk.targets, which consumes them.
	-->
	<PropertyGroup Condition="'$(_CohesionResourceSdk)' == 'true' and '$(OutputType)' == 'Exe'">
		<SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(SelfContained)' == 'true'">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
		<ValidateExecutableReferencesMatchSelfContained Condition="'$(ValidateExecutableReferencesMatchSelfContained)' == ''">false</ValidateExecutableReferencesMatchSelfContained>
	</PropertyGroup>

	<!--
		The resource SDK props mark default None items for copy (appsettings*.json; wwwroot/** in
		Sdk.Web). A project that also adds those files as Content, the ASP.NET habit
		(<Content Include="wwwroot\**" />), would then copy each file twice, and publish rejects
		duplicate output paths (NETSDK1152). The project's own Content item wins. This runs after
		the project body, where those Content items are declared.
	-->
	<ItemGroup Condition="'$(_CohesionResourceSdk)' == 'true' and '$(OutputType)' == 'Exe'">
		<None Remove="@(Content)" />
	</ItemGroup>

    <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />
    <Import Project="..\Targets\Assimalign.Cohesion.Sdk.PinValidation.targets" />
    <Import Project="..\Targets\Assimalign.Cohesion.Sdk.StronglyTypedSettings.targets" />
    <Import Project="..\Targets\Assimalign.Cohesion.Sdk.NameOnly.ProjectReference.targets" />

	<Target Name="CohesionValidateApplicationModelSdkImport" BeforeTargets="PrepareForBuild;CoreCompile">
		<Error
			Condition="'$(CohesionApplicationModel)' != 'disabled' and '$(CohesionApplicationModel)' != 'enabled'"
			File="$(MSBuildProjectFullPath)"
			Text="CohesionApplicationModel must be 'disabled' or 'enabled'." />
		<Error
			Condition="'$(CohesionApplicationModel)' == 'enabled' and '$(_CohesionApplicationModelSdkImported)' != 'true'"
			Code="COHSDK011"
			File="$(MSBuildProjectFullPath)"
			Text="Project '$(MSBuildProjectName)' enables CohesionApplicationModel, but Assimalign.Cohesion.Sdk.ApplicationModel was not imported. Use a Cohesion resource-area SDK or add &lt;Import Project=&quot;Sdk.targets&quot; Sdk=&quot;Assimalign.Cohesion.Sdk.ApplicationModel&quot; Version=&quot;$(CohesionVersion)&quot; /&gt; after the enabling property." />
	</Target>

	<!-- Private handshake used to distinguish a disabled reference from a missing manifest. -->
	<Target Name="_CohesionGetApplicationModelState" Returns="@(_CohesionApplicationModelState)">
		<ItemGroup>
			<_CohesionApplicationModelState Include="$(MSBuildProjectFullPath)">
				<ApplicationModel>$(CohesionApplicationModel)</ApplicationModel>
				<ProjectName>$(MSBuildProjectName)</ProjectName>
				<ProjectFullPath>$(MSBuildProjectFullPath)</ProjectFullPath>
				<IsSelf>true</IsSelf>
			</_CohesionApplicationModelState>
		</ItemGroup>
	</Target>

</Project>
