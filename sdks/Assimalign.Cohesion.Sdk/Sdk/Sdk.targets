<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >
	<PropertyGroup>
		<_CohesionImageSelfContainedInput>$(SelfContained)</_CohesionImageSelfContainedInput>
		<_CohesionImagePublishSelfContainedInput>$(PublishSelfContained)</_CohesionImagePublishSelfContainedInput>
		<!-- Capture the image RID before the SDK supplies a host-build RID. -->
		<CohesionImageRuntimeIdentifier Condition="'$(CohesionImageRuntimeIdentifier)' == ''">$(RuntimeIdentifier)</CohesionImageRuntimeIdentifier>
		<CohesionImageRuntimeIdentifier Condition="'$(CohesionImageRuntimeIdentifier)' == ''">linux-x64</CohesionImageRuntimeIdentifier>
	</PropertyGroup>
	<!--
		Enabled resource executables use one self-contained host-runtime posture on every
		host and in every configuration: the Cohesion shared frameworks exist only as NuGet
		Ref/Runtime packs, so a framework-dependent build cannot start on a machine without
		the installed framework layout. Set these defaults after the consumer project has
		been evaluated but before Microsoft.NET.Sdk imports its target-time RID and apphost
		logic. Project files no longer repeat them; a consumer assignment or a command-line
		property still wins, and image publication supplies its own RID and posture.
	-->
	<PropertyGroup Condition="'$(CohesionApplicationModel)' == 'enabled'">
		<SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
		<ValidateExecutableReferencesMatchSelfContained Condition="'$(ValidateExecutableReferencesMatchSelfContained)' == ''">false</ValidateExecutableReferencesMatchSelfContained>
	</PropertyGroup>
	<!--
		Every Cohesion framework a project needs is referenced explicitly by its SDK (App,
		the area SDK's App.<Area>, and the Gateway SDK's per-referenced-area set), so no
		transitive framework reference ever needs its own runtime-pack download. Without
		this, a RID-specific or self-contained restore downloads the runtime pack of every
		registered area.
	-->
	<PropertyGroup>
		<DisableTransitiveFrameworkReferenceDownloads Condition="'$(DisableTransitiveFrameworkReferenceDownloads)' == ''">true</DisableTransitiveFrameworkReferenceDownloads>
	</PropertyGroup>

    <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />
    <Import Project="..\Targets\Assimalign.Cohesion.Sdk.PinValidation.targets" />
    <Import Project="..\Targets\Assimalign.Cohesion.Sdk.StronglyTypedSettings.targets" />
	<Import Project="..\Targets\Assimalign.Cohesion.Sdk.ApplicationModel.Build.targets" />
    <Import Project="..\Targets\Assimalign.Cohesion.Sdk.NameOnly.ProjectReference.targets" />

</Project>
