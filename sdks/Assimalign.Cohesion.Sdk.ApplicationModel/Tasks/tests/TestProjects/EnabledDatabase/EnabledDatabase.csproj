<Project Sdk="Assimalign.Cohesion.Sdk.Database">

  <PropertyGroup>
    <RootNamespace>EnabledDatabase</RootNamespace>
    <CohesionApplicationModel>enabled</CohesionApplicationModel>
    <CohesionApplication>inventory</CohesionApplication>
    <CohesionResourceName>inventory-database</CohesionResourceName>
  </PropertyGroup>

  <ItemGroup>
    <CohesionEndpoint Update="db" DevPort="15740" />
  </ItemGroup>
  <ItemGroup>
    <CohesionSetting Include="Database:PoolSize" Default="20" Type="int" />
  </ItemGroup>
  <ItemGroup>
    <CohesionResourceReference Include="..\EnabledDependency\EnabledDependency.csproj" Endpoints="db" />
  </ItemGroup>
  <ItemGroup>
    <CohesionResourceProperty Include="database.engine" Value="PostgreSql" />
  </ItemGroup>

</Project>
