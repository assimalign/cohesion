<Project Sdk="Assimalign.Cohesion.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>ManagedWeb</RootNamespace>
    <CohesionApplicationModel>enabled</CohesionApplicationModel>
    <CohesionApplication>managed</CohesionApplication>
    <CohesionResourceName>api</CohesionResourceName>
  </PropertyGroup>
  <ItemGroup>
    <CohesionPackageReference Include="Assimalign.Cohesion.Web.Hosting.Management" Version="$(CohesionVersion)" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
