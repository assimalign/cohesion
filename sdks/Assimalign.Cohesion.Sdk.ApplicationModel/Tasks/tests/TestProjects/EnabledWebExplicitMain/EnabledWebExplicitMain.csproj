<Project Sdk="Assimalign.Cohesion.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>EnabledWebExplicitMain</RootNamespace>
    <CohesionApplicationModel>enabled</CohesionApplicationModel>
    <CohesionApplication>inventory</CohesionApplication>
    <CohesionResourceName>inventory-explicit-main</CohesionResourceName>
  </PropertyGroup>

  <ItemGroup>
    <CohesionEndpoint Update="http" DevPort="18081" />
  </ItemGroup>

  <Target Name="CaptureSdkDefaults" AfterTargets="Build">
    <WriteLinesToFile
      File="$(BaseIntermediateOutputPath)sdk-defaults.txt"
      Lines="$(OutputType)|$(TargetFramework)|$(LangVersion)|$(EnablePreviewFeatures)|$(ImplicitUsings)|$(Nullable)|$(IsAotCompatible)"
      Overwrite="true" />
  </Target>

</Project>
