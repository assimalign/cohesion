<Project Sdk="Assimalign.Cohesion.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>DisabledResource</RootNamespace>
    <Nullable>disable</Nullable>
    <CohesionApplicationModel>disabled</CohesionApplicationModel>
  </PropertyGroup>

  <ItemGroup>
    <CohesionCommand Include="web.custom" />
  </ItemGroup>

  <Target Name="CaptureSdkDefaults" AfterTargets="Build">
    <WriteLinesToFile
      File="$(BaseIntermediateOutputPath)sdk-defaults.txt"
      Lines="$(OutputType)|$(TargetFramework)|$(LangVersion)|$(EnablePreviewFeatures)|$(ImplicitUsings)|$(Nullable)|$(IsAotCompatible)"
      Overwrite="true" />
  </Target>

</Project>
