<Project>
	<ItemGroup>
		<CohesionResourceManifest
			Include="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../cohesion/resource.json'))"
			ManifestPath="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../cohesion/resource.json'))"
			RuntimeSurfacePath="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../cohesion/resource.runtime.json'))"
			PackageId="$(MSBuildThisFileName)"
			ReferenceIdentity="$(MSBuildThisFileName)"
			IsSelf="false" />
	</ItemGroup>
</Project>
