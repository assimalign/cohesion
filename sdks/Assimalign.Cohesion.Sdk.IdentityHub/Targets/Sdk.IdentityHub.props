<Project>
	<!--
		Area orchestration defaults use Include so a consuming project can override
		a named item with Update, for example:
		<CohesionEndpoint Update="https" Public="true" />.
		The resource's domain composition remains in its Program.cs.
	-->
	<PropertyGroup>
		<CohesionResourceApplicationModel Condition="'$(CohesionResourceApplicationModel)' == ''">Assimalign.Cohesion.IdentityHub.ApplicationModel</CohesionResourceApplicationModel>
		<CohesionResourceControlPlaneType Condition="'$(CohesionResourceControlPlaneType)' == ''">Assimalign.Cohesion.IdentityHub.ApplicationModel.IdentityHubResourceControlPlane</CohesionResourceControlPlaneType>
		<CohesionResourceKind Condition="'$(CohesionResourceKind)' == ''">IdentityHub</CohesionResourceKind>
		<CohesionControlPlaneEndpoint Condition="'$(CohesionControlPlaneEndpoint)' == ''">https</CohesionControlPlaneEndpoint>
		<CohesionControlPlanePath Condition="'$(CohesionControlPlanePath)' == ''">/cohesion/v1</CohesionControlPlanePath>
		<CohesionWorkloadKind Condition="'$(CohesionWorkloadKind)' == ''">StatefulSet</CohesionWorkloadKind>
		<CohesionReplicas Condition="'$(CohesionReplicas)' == ''">1</CohesionReplicas>
		<CohesionMaxReplicas Condition="'$(CohesionMaxReplicas)' == ''">1</CohesionMaxReplicas>
	</PropertyGroup>

	<ItemGroup>
		<CohesionCommand Include="identityhub.add-audience;identityhub.add-client" />
		<CohesionEndpoint Include="https" Scheme="https" Certificate="tls" ContainerPort="8443" Public="false" />
		<CohesionProbe Include="readiness" Endpoint="https" Http="/readyz" />
		<CohesionProbe Include="liveness" Endpoint="https" Http="/livez" />
		<CohesionMount Include="tls" Kind="Secret" ContainerPath="/cohesion/mounts/tls" />
		<CohesionMount Include="data" Kind="Volume" ContainerPath="/data" Size="10Gi" />
	</ItemGroup>
</Project>
