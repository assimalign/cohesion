<Project>
	<Import Project="..\Directory.Build.props" />

	<!--
	    The SDK family root - sdks/Assimalign.Cohesion.Sdk[.Domain]/ - resolved from the
	    project's own location rather than assumed. Every project in a family lives exactly
	    two levels below it (Tasks/src, Tasks/tests, Tasks/docs), so one expression serves
	    them all. Directory.Build.targets packs Sdk/ and Targets/ relative to THIS, not to
	    $(MSBuildProjectDirectory)\.. - that older form silently packed an SDK with no Sdk/
	    or Targets/ folder the moment a project moved a level, which is exactly what the
	    Tasks/src layout did.
	-->
	<PropertyGroup>
		<CohesionSdkRootDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))\</CohesionSdkRootDirectory>
	</PropertyGroup>

	<!-- Shared package properties -->
	<PropertyGroup>
		<TargetFramework>$(TargetFrameworkForSdks)</TargetFramework>
		<OutputType>Library</OutputType>
		<!-- <EnableDefaultItems>false</EnableDefaultItems> -->
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<AutoGenerateAssemblyVersion>true</AutoGenerateAssemblyVersion>
		<!-- MSBuild Task DLLs need to be versioned with every build -->
		<IsPackable>true</IsPackable>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
	</PropertyGroup>
	<!-- Package Metadata -->
	<PropertyGroup>
		<!-- VersionPrefix/VersionSuffix split (not <Version> directly): a prerelease
		     semver like "11.0.2-preview.1" handed straight to <Version> propagates
		     to [assembly: AssemblyVersion] and trips CS7034. The SDK composes
		     Version = $(VersionPrefix)-$(VersionSuffix) at the end, which becomes
		     PackageVersion via the default. -->
		<VersionPrefix>$(CohesionVersionPrefix)</VersionPrefix>
		<VersionSuffix Condition="'$(CohesionVersionSuffix)' != ''">$(CohesionVersionSuffix)</VersionSuffix>
		<Authors>Assimalign</Authors>
		<Description>Cohesion MSBuild SDK and local packaging feed for framework, library, and resource packages.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>Sdk;MSBuild;Cohesion</PackageTags>
	</PropertyGroup>
</Project>
