<Project>
	<!--
		Area orchestration defaults use Include so a consuming project can override
		a named item with Update, for example:
		<CohesionEndpoint Update="dns" Public="true" />.
		The resource's domain composition remains in its Program.cs.
	-->
	<PropertyGroup>
		<CohesionResourceApplicationModel Condition="'$(CohesionResourceApplicationModel)' == ''">Assimalign.Cohesion.Rezolvr.ApplicationModel</CohesionResourceApplicationModel>
		<CohesionResourceControlPlaneType Condition="'$(CohesionResourceControlPlaneType)' == ''">Assimalign.Cohesion.ApplicationModel.RezolvrResourceControlPlane</CohesionResourceControlPlaneType>
		<CohesionResourceKind Condition="'$(CohesionResourceKind)' == ''">Rezolvr</CohesionResourceKind>
		<CohesionControlPlaneEndpoint Condition="'$(CohesionControlPlaneEndpoint)' == ''">admin</CohesionControlPlaneEndpoint>
		<CohesionControlPlanePath Condition="'$(CohesionControlPlanePath)' == ''">/cohesion/v1</CohesionControlPlanePath>
		<CohesionWorkloadKind Condition="'$(CohesionWorkloadKind)' == ''">Deployment</CohesionWorkloadKind>
	</PropertyGroup>

	<ItemGroup>
		<CohesionCommand Include="rezolvr.add-a-record;rezolvr.add-cname-record" />
		<CohesionEndpoint Include="dns" Scheme="dns" Protocol="udp" ContainerPort="53" Public="false" />
		<CohesionEndpoint Include="dns-tcp" Scheme="dns" Protocol="tcp" ContainerPort="53" Public="false" />
		<CohesionEndpoint Include="admin" Scheme="http" ContainerPort="8081" Public="false" />
		<CohesionProbe Include="readiness" Endpoint="admin" Http="/readyz" />
		<CohesionProbe Include="liveness" Endpoint="admin" Http="/livez" />
	</ItemGroup>
</Project>
