<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Drives ConfigurationStoreSourceProvider against a recording transport and against a real
		ConfigurationStore.Hosting host, and runs an application set through a real
		ApplicationModel.Gateway so a member's UseConfigurationStore registration resolves its mounts
		end to end. Test projects are exempt from the resource guards by path, so the harness may
		compose the runtime module and the gateway the package itself never references.
	-->
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.ConfigurationStore.ApplicationModel.Orchestration.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<CohesionPackageReference Include="Microsoft.NET.Test.Sdk" />
		<CohesionPackageReference Include="coverlet.collector" />
		<CohesionPackageReference Include="xunit" />
		<CohesionPackageReference Include="xunit.runner.visualstudio" />
		<CohesionPackageReference Include="Shouldly" />
		<CohesionProjectReference Include="Assimalign.Cohesion.ConfigurationStore.ApplicationModel.Orchestration" />
		<CohesionProjectReference Include="Assimalign.Cohesion.ApplicationModel" />
		<CohesionProjectReference Include="Assimalign.Cohesion.ApplicationModel.Gateway" />
		<CohesionProjectReference Include="Assimalign.Cohesion.ConfigurationStore.Client" />
		<CohesionProjectReference Include="Assimalign.Cohesion.ConfigurationStore.Hosting" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting.Resources" />
		<CohesionProjectReference Include="Assimalign.Cohesion.IdentityModel" />
		<CohesionProjectReference Include="Assimalign.Cohesion.IdentityModel.Token" />
		<CohesionProjectReference Include="Assimalign.Cohesion.IdentityModel.Token.JsonWebToken" />
	</ItemGroup>
</Project>
