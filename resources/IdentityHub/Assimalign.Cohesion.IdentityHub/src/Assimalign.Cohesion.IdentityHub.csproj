<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.IdentityHub</RootNamespace>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Core" />
		<CohesionProjectReference Include="Assimalign.Cohesion.IdentityModel" />
		<CohesionProjectReference Include="Assimalign.Cohesion.IdentityHub.Models" />
	</ItemGroup>
	<ItemGroup>
		<!-- The store seam's address vocabulary. Each rule lives once, in the type's IsValid. -->
		<CohesionValueType Include="ValueObjects\IdentityHubRecordSetName.cs"
						   ObjectRuntimeType="String"
						   ObjectNamespace="Assimalign.Cohesion.IdentityHub"
						   ObjectAccessModifier="public"
						   ObjectHasImplicitOperators="true"
						   ObjectHasIsValidMethod="true"
						   ObjectComparison="Ordinal" />
		<CohesionValueType Include="ValueObjects\IdentityHubRecordIndexName.cs"
						   ObjectRuntimeType="String"
						   ObjectNamespace="Assimalign.Cohesion.IdentityHub"
						   ObjectAccessModifier="public"
						   ObjectHasImplicitOperators="true"
						   ObjectHasIsValidMethod="true"
						   ObjectComparison="Ordinal" />
		<CohesionValueType Include="ValueObjects\IdentityHubRecordKey.cs"
						   ObjectRuntimeType="String"
						   ObjectNamespace="Assimalign.Cohesion.IdentityHub"
						   ObjectAccessModifier="public"
						   ObjectHasImplicitOperators="true"
						   ObjectHasIsValidMethod="true"
						   ObjectComparison="Ordinal" />
		<CohesionValueType Include="ValueObjects\IdentityHubRecordVersion.cs"
						   ObjectRuntimeType="String"
						   ObjectNamespace="Assimalign.Cohesion.IdentityHub"
						   ObjectAccessModifier="public"
						   ObjectHasImplicitOperators="true"
						   ObjectHasIsValidMethod="true"
						   ObjectComparison="Ordinal" />
		<!-- The app registration vocabulary. Each compares ordinally: RFC 6749 treats a client identifier and a scope token as exact strings, and RFC 7519 compares an audience the same way. -->
		<CohesionValueType Include="ValueObjects\IdentityClientId.cs"
						   ObjectRuntimeType="String"
						   ObjectNamespace="Assimalign.Cohesion.IdentityHub"
						   ObjectAccessModifier="public"
						   ObjectHasImplicitOperators="true"
						   ObjectHasIsValidMethod="true"
						   ObjectComparison="Ordinal" />
		<CohesionValueType Include="ValueObjects\IdentityClientCredentialId.cs"
						   ObjectRuntimeType="String"
						   ObjectNamespace="Assimalign.Cohesion.IdentityHub"
						   ObjectAccessModifier="public"
						   ObjectHasImplicitOperators="true"
						   ObjectHasIsValidMethod="true"
						   ObjectComparison="Ordinal" />
		<CohesionValueType Include="ValueObjects\IdentityClientPermissionName.cs"
						   ObjectRuntimeType="String"
						   ObjectNamespace="Assimalign.Cohesion.IdentityHub"
						   ObjectAccessModifier="public"
						   ObjectHasImplicitOperators="true"
						   ObjectHasIsValidMethod="true"
						   ObjectComparison="Ordinal" />
		<CohesionValueType Include="ValueObjects\IdentityClientAudience.cs"
						   ObjectRuntimeType="String"
						   ObjectNamespace="Assimalign.Cohesion.IdentityHub"
						   ObjectAccessModifier="public"
						   ObjectHasImplicitOperators="true"
						   ObjectHasIsValidMethod="true"
						   ObjectComparison="Ordinal" />
	</ItemGroup>
</Project>
