<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Deviates from the repo hosting-library rule (COHRES004) per design decision O34: migration gate, removed by #992 slice 2. -->
		<CohesionHostingLibraryReferenceMigration>true</CohesionHostingLibraryReferenceMigration>
	</PropertyGroup>
	<ItemGroup>
		<Folder Include="Client\" />
	</ItemGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting" />
		<CohesionProjectReference Include="Assimalign.Cohesion.IdentityModel" />
	</ItemGroup>
	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
</Project>
