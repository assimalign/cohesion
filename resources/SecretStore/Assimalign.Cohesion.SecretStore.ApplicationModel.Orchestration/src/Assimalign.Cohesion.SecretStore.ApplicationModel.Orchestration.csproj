<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Opt-in orchestration package: the gateway-side SecretStore providers (secret and certificate
		mount sources, certificate authority, trusted-issuer store, and the secretstore.add-secret
		command-input resolver) registered through builder.UseSecretStore(store). It references only
		the ApplicationModel seams and the Core-only SecretStore client, never Hosting*,
		ApplicationModel.Gateway*, or SecretStore.ApplicationModel (COHRES001/003/004).
		NuGet-only: never a member of the App.SecretStore shared framework.
	-->
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.ApplicationModel</RootNamespace>
		<Description>Opt-in gateway providers backed by a SecretStore resource: secret and certificate mount sources, the application certificate authority, the trusted-issuer store, and secretstore.add-secret payload resolution, registered through builder.UseSecretStore(store).</Description>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.ApplicationModel" />
		<CohesionProjectReference Include="Assimalign.Cohesion.SecretStore.Client" />
	</ItemGroup>
</Project>
