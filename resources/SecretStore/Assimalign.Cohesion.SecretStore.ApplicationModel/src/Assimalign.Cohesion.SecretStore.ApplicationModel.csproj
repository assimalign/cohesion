<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Declarative ApplicationModel project: describes secret-store resources and supplies
		the area's default control-plane factory. It references only ApplicationModel and
		the Core-only Hosting seam, never the SecretStore runtime.
	-->
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.ApplicationModel</RootNamespace>
		<!-- Enforce the strict ApplicationModel dependency closure (COHAM001). -->
		<CohesionApplicationModelGuard>true</CohesionApplicationModelGuard>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.ApplicationModel" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting.Resources" />
	</ItemGroup>
	<ItemGroup>
		<CohesionSharedSource Include="Assimalign.Cohesion.SecretStore.ApplicationModel" Module="Commands" />
	</ItemGroup>
	<ItemGroup>
		<!-- Command storage/source identifiers preserve the SecretStore protocol's ordinal spelling. -->
		<CohesionValueType Include="ValueObjects\SecretStoreCommandSource.cs"
			ObjectRuntimeType="String" ObjectNamespace="Assimalign.Cohesion.ApplicationModel"
			ObjectAccessModifier="public" ObjectHasImplicitOperators="true"
			ObjectHasIsValidMethod="true" ObjectComparison="Ordinal" />
		<CohesionValueType Include="ValueObjects\SecretStoreCommandPath.cs"
			ObjectRuntimeType="String" ObjectNamespace="Assimalign.Cohesion.ApplicationModel"
			ObjectAccessModifier="public" ObjectHasImplicitOperators="true"
			ObjectHasIsValidMethod="true" ObjectComparison="Ordinal" />
		<CohesionValueType Include="ValueObjects\SecretStoreCertificateName.cs"
			ObjectRuntimeType="String" ObjectNamespace="Assimalign.Cohesion.ApplicationModel"
			ObjectAccessModifier="public" ObjectHasImplicitOperators="true"
			ObjectHasIsValidMethod="true" ObjectComparison="Ordinal" />
		<!-- RFC 1035 section 2.3.3: DNS labels compare without case; preserve their stored spelling. -->
		<CohesionValueType Include="ValueObjects\SecretStoreSubjectAlternativeName.cs"
			ObjectRuntimeType="String" ObjectNamespace="Assimalign.Cohesion.ApplicationModel"
			ObjectAccessModifier="public" ObjectHasImplicitOperators="true"
			ObjectHasIsValidMethod="true" ObjectComparison="OrdinalIgnoreCase" />
	</ItemGroup>
</Project>
