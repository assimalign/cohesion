<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Web.Testing</RootNamespace>
		<Description>Integration testing for Cohesion web applications. WebApplicationTestFactory supports socketless HTTP/1.1 and HTTP/2 composition over the in-memory transport.</Description>
		<!-- Sanctioned exception to the resource hosting-isolation rule (COHRES001,
		     .claude/rules/resource-areas.md): the test factory drives the concrete runtime
		     (WebApplication/WebApplicationBuilder), which cannot be done through the
		     abstractions alone. -->
		<CohesionHostingIsolationExemptions>Assimalign.Cohesion.Web.Hosting</CohesionHostingIsolationExemptions>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Web" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Hosting" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Http.Connections" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.InMemory" />
		<CohesionProjectReference Include="Assimalign.Cohesion.DependencyInjection" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting" />
	</ItemGroup>
</Project>
