<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Web.StaticFiles</RootNamespace>
		<Description>Static file serving for the Cohesion Web pipeline over the FileSystem library. builder.Services.AddStaticFiles registers the middleware over any IFileSystem (physical, in-memory, aggregate), or the application's web root, at a request-path prefix with registration-time options: default documents, Cache-Control, content-type overlays; UseStaticFiles places it. Implements RFC 9110 conditional GET (ETag from Size+UpdatedOn, Last-Modified, If-None-Match/If-Modified-Since to 304), single byte-range 206/416 responses, HEAD, precompressed sibling (.br/.gz) negotiation with Content-Encoding + Vary, and hard path-traversal defense (requests can never escape the mounted root). The SendFileAsync and WriteStreamAsync response helpers give handlers the same conditional-request and single-range handling for a file, a mount-confined path, or a stream with caller-supplied validators.</Description>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Web" />
		<!-- Request correlation uses the contracts-only server feature. -->
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Server" />
		<!-- MapFallbackToFile maps a fallback route on the application router. -->
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Routing" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Http" />
		<CohesionProjectReference Include="Assimalign.Cohesion.FileSystem" />
		<CohesionProjectReference Include="Assimalign.Cohesion.FileSystem.Physical" />
	</ItemGroup>
	<ItemGroup>
		<CohesionSharedSource Include="Assimalign.Cohesion.Core" Module="ComponentIntegration" />
	</ItemGroup>
</Project>
