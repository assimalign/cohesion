<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Web.Hosting</RootNamespace>
	</PropertyGroup>
	<!-- Web-area dependency rule: the hosting/runtime module references the root
	     Assimalign.Cohesion.Web project, the Web features it runs, and non-Web-area libraries.
	     Health and Resources integrate here (decision 57, 2026-10-13). COHRES002 (relaxed
	     2026-10-09) lets it reference any other Web library except Web.Testing,
	     Web.ApplicationModel, the App.Web producers, and harnesses - but only for runtime machinery
	     it composes itself: the App.Web shared framework delivers features to applications, their
	     builder verbs ship in their own packages, and every reference added here ships its closure
	     in all 18 area frameworks. See resources/Web/README.md. -->
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Web" />
		<!-- Owner decision 33 (#1379): the pipeline ends in Web.Routing's WebApplicationTerminal. -->
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Routing" />
		<!-- Owner decision 57 (b) (#1458): the public engine and its exchange features live in Web.Server. -->
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Server" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Health" />
		<CohesionProjectReference Include="Assimalign.Cohesion.IdentityModel.Token.JsonWebToken" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting.Health" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting.Resources" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting.Telemetry" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Logging" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Logging.EventSource" />
		<CohesionProjectReference Include="Assimalign.Cohesion.DependencyInjection" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Configuration" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Configuration.CommandLine" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Configuration.EnvironmentVariables" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Configuration.Json" />
		<CohesionProjectReference Include="Assimalign.Cohesion.FileSystem" />
		<CohesionProjectReference Include="Assimalign.Cohesion.FileSystem.Physical" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Http.Connections" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Http.ProtocolUpgrade" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Http.ExtendedConnect" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Http.RequestLimits" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.Tcp" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.Quic" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.Security" />
	</ItemGroup>
	<ItemGroup>
		<CohesionSharedSource Include="Assimalign.Cohesion.Hosting.Resources" Module="CommandDiagnostics" />
		<CohesionSharedSource Include="Assimalign.Cohesion.IdentityModel.Token.JsonWebToken" Module="Validation" />
	</ItemGroup>
</Project>
