<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Assimalign.Cohesion.Web.Hosting.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <CohesionProjectReference Include="Assimalign.Cohesion.Web.Hosting" />
    <CohesionProjectReference Include="Assimalign.Cohesion.Web.Testing" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting.Health" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting.Resources" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Http" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Http.Connections" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Http.RequestLimits" />
		<!-- Test-only: a stream that faults after its response started through the streaming feature
		     must be reset, not finalized (#1049). The runtime module takes no dependency on it. -->
		<CohesionProjectReference Include="Assimalign.Cohesion.Http.Streaming" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Configuration" />
		<!-- Test-only: a raw in-memory connection pipelines HTTP/1.1 requests, which a real client never does. -->
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.InMemory" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.Tcp" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.Quic" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.Security" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Security.DataProtection" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Authentication" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Authentication.Cookie" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Authentication.Bearer" />
    <CohesionPackageReference Include="coverlet.collector" />
    <CohesionPackageReference Include="Microsoft.NET.Test.Sdk" />
    <CohesionPackageReference Include="Shouldly" />
    <CohesionPackageReference Include="xunit" />
    <CohesionPackageReference Include="xunit.runner.visualstudio" GeneratePathProperty="true" />
  </ItemGroup>

  <Target Name="EnsureVSTestSupportFiles" AfterTargets="Build">
    <Copy SourceFiles="$(Pkgxunit_runner_visualstudio)\build\net8.0\xunit.runner.visualstudio.testadapter.dll"
          DestinationFiles="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(OutputPath)xunit.runner.visualstudio.testadapter.dll'))"
          SkipUnchangedFiles="true"
          Condition="'$(Pkgxunit_runner_visualstudio)' != '' and Exists('$(Pkgxunit_runner_visualstudio)\build\net8.0\xunit.runner.visualstudio.testadapter.dll')" />
  </Target>

</Project>
