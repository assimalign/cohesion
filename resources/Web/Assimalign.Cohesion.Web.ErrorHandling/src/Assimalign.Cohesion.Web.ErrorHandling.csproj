<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Web.ErrorHandling</RootNamespace>
		<Description>The OnError fault seam for the Cohesion Web pipeline: builder-time registration of the error handlers through which an application owns its fault responses (builder.Services.AddErrorHandling(errors =&gt; errors.OnError(...))), the IErrorHandlingFeature exchange feature that exception boundaries invoke, and the terminal default that renders the RFC 9457 Web.ProblemDetails payload. Faults only — expected protocol outcomes (401 challenges, 404s, 415s) remain each feature's normal response path.</Description>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Http" />
		<!-- IHttpResponseStreamingFeature.HasStarted is the boundary's no-clobber signal (whether the
		     response head is committed) — the same wire-commit truth the request-timeout middleware
		     reads. Outside the Web area, so unconstrained by the hosting-isolation rule. -->
		<CohesionProjectReference Include="Assimalign.Cohesion.Http.Streaming" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.ProblemDetails" />
		<!-- IWebClientFaultFeature tells the boundary that the transport answers a client fault itself
		     (#1340), so it skips OnException and the 500 problem. Feature-to-feature, as the Web
		     dependency rule allows. -->
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Server" />
	</ItemGroup>
</Project>
