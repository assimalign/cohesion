<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Family pin (general-rules.md, "Every project pins its RootNamespace"): the contracts left
		     the Web root under owner decision 33 (#1379) and keep the namespace they shipped in, as
		     Web.Api, Web.Forms and Web.ProblemDetails do, so every reader keeps compiling. -->
		<RootNamespace>Assimalign.Cohesion.Web</RootNamespace>
		<Description>The Cohesion Web server engine and the per-exchange request identity, activity, response lifecycle, drain and client-fault contracts it publishes. Construct WebApplicationServer directly from a pipeline and listener options, or compose it through Assimalign.Cohesion.Web.Hosting.</Description>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Web" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Http" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Http.Connections" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Routing" />
	</ItemGroup>
</Project>
