<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Family pin (general-rules.md, "Every project pins its RootNamespace"): the contracts left
		     the Web root under owner decision 33 (#1379) and keep the namespace they shipped in, as
		     Web.Api, Web.Forms and Web.ProblemDetails do, so every reader keeps compiling. -->
		<RootNamespace>Assimalign.Cohesion.Web</RootNamespace>
		<Description>The per-exchange contracts the Cohesion Web server publishes: the request id (IWebRequestIdFeature, the W3C trace id that names the request in the server span, logs and responses), post-response completion callbacks (IWebResponseCompletionFeature), the server's lame-duck drain signal (IWebServerDrainFeature), and the client-fault report (IWebClientFaultFeature, the 4xx the transport answers a request body that broke its framing or a limit with). Contracts only: Assimalign.Cohesion.Web.Hosting installs them, and a custom IWebApplicationServer may omit them.</Description>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Web" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Http" />
	</ItemGroup>
</Project>
