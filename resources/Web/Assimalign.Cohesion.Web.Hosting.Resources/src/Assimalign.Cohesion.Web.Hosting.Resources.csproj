<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Web.Hosting.Resources</RootNamespace>
		<Description>Runs a Cohesion Web application as a managed resource instance: it publishes its manifest to the gateway that provisioned it, serves its control plane on a private listener, and exposes its CORS policy as a resource state action.</Description>
		<!-- The <Area>.Hosting.Resources packages join Hosting.Resources to the area's runtime
		     module, so they reference it (owner decision 2026-10-28). -->
		<CohesionHostingIsolationExemptions>Assimalign.Cohesion.Web.Hosting</CohesionHostingIsolationExemptions>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Web" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Hosting" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Server" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Web.Cors" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting.Resources" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Http" />
	</ItemGroup>
</Project>
