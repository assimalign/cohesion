<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Deviates from the repo hosting-library rule (COHRES004) per design decision O34: migration gate, removed by #992 slice 2. -->
		<CohesionHostingLibraryReferenceMigration>true</CohesionHostingLibraryReferenceMigration>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="Delegates\**" />
		<Compile Remove="Internal\ScheduleTaskScheduler.cs" />
		<Compile Remove="Internal\SoftSchedulerNotifyDebounce.cs" />
		<Compile Remove="ValueObjects\JobId.generated.cs" />
		<Compile Remove="ValueObjects\ScheduleId.generated.cs" />
		<EmbeddedResource Remove="Delegates\**" />
		<EmbeddedResource Remove="Extensions\**" />
		<None Remove="Delegates\**" />
	</ItemGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Core" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting" />
	</ItemGroup>
	<ItemGroup>
		<CohesionValueType
			Include="ValueTypes\JobId.cs"
			ObjectRuntimeType="Ulid"
			ObjectNamespace="Assimalign.Cohesion.Scheduler"
			ObjectAccessModifier="public"
			ObjectHasImplicitOperators="true" />
		<CohesionValueType
			Include="ValueTypes\ScheduleId.cs"
			ObjectRuntimeType="Ulid"
			ObjectNamespace="Assimalign.Cohesion.Scheduler"
			ObjectAccessModifier="public"
			ObjectHasImplicitOperators="true" />
	</ItemGroup>
</Project>
