<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Database.Transactions.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<!-- Allocation guards describe the optimized path, as NativeAOT does. Runtime
		     tier transitions and first-use helpers must not enter the measured loop. -->
		<TieredCompilation>false</TieredCompilation>
		<!-- dotnet/runtime#134724: background GC can charge abandoned allocation-context
		     bytes to a zero-allocation interval. Keep the exact guard and verify this setting. -->
		<ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="$(CohesionRepositoryDirectory)resources\Database\Assimalign.Cohesion.Database.Storage\tests\TestObjects\DedicatedTestTask.cs" Link="TestObjects\DedicatedTestTask.cs" />
		<CohesionPackageReference Include="Microsoft.NET.Test.Sdk" />
		<CohesionPackageReference Include="coverlet.collector" />
		<CohesionPackageReference Include="xunit" />
		<CohesionPackageReference Include="xunit.runner.visualstudio" />
		<CohesionPackageReference Include="Shouldly" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Transactions" />
		<Compile Include="$(CohesionRepositoryDirectory)build\TestSupport\EventSourceRecorder.cs" Link="Shared\EventSourceRecorder.cs" />
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\SimulatedDurableFileHandle.cs" Link="TestObjects\SimulatedDurableFileHandle.cs" />
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\FaultingMemoryStream.cs" Link="TestObjects\FaultingMemoryStream.cs" />
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\CrashSimulationStream.cs" Link="TestObjects\CrashSimulationStream.cs" />
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\CrashPoint.cs" Link="TestObjects\CrashPoint.cs" />
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\SimulatedPowerLossException.cs" Link="TestObjects\SimulatedPowerLossException.cs" />
	</ItemGroup>
</Project>
