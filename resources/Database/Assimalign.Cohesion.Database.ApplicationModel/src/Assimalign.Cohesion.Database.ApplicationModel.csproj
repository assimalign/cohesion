<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Declarative ApplicationModel project: describes database resources and supplies
		the area's default control-plane factory. It references only ApplicationModel
		and the Core-only Hosting seam, never the database runtime.
	-->
	<PropertyGroup>
		<!-- Enforce the strict ApplicationModel dependency closure (COHAM001). -->
		<CohesionApplicationModelGuard>true</CohesionApplicationModelGuard>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.ApplicationModel" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting" />
	</ItemGroup>
</Project>
