<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Database.Hosting</RootNamespace>
	</PropertyGroup>
	<!--
		Composition-only, COHRES002-clean: the hosting module references only the
		area root inside the area, plus non-area hosting infrastructure. The private
		Web.Hosting/Web.Health references implement the Database admin control plane
		without exposing Web APIs. Database server runtimes remain per-model; this
		module composes IDatabaseServer instances through the root seam and has no
		model-specific wire knowledge.
	-->
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Database" />
		<CohesionProjectReference Include="Assimalign.Cohesion.DependencyInjection" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Configuration" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Configuration.Json" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Configuration.EnvironmentVariables" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Configuration.CommandLine" />
		<CohesionProjectReference Include="Assimalign.Cohesion.FileSystem.Physical" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting.Health" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting.Resources" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting.Telemetry" />
		<CohesionPrivateProjectReference Include="Assimalign.Cohesion.Web.Hosting" />
		<CohesionPrivateProjectReference Include="Assimalign.Cohesion.Web.Hosting.Resources" />
		<CohesionPrivateProjectReference Include="Assimalign.Cohesion.Web.Hosting.Health" />
		<CohesionPrivateProjectReference Include="Assimalign.Cohesion.Web.Health" />
	</ItemGroup>
</Project>
