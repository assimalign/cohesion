<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Database.Hosting.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<CohesionPackageReference Include="Microsoft.NET.Test.Sdk" />
		<CohesionPackageReference Include="coverlet.collector" />
		<CohesionPackageReference Include="xunit" />
		<CohesionPackageReference Include="xunit.runner.visualstudio" />
		<CohesionPackageReference Include="Shouldly" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Hosting" />
		<CohesionProjectReference Include="Assimalign.Cohesion.IdentityModel.Token.JsonWebToken" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting.Health" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Hosting.Resources" />
		<!-- Composition acceptance: the host runs a real SQL engine fronted by the
		     SQL model's server (SqlDatabaseServer, implemented inside Database.Sql)
		     on the in-memory driver, driven end-to-end by a client (tests are
		     exempt from the area layering rules). -->
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Sql" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Documents" />
		<!-- The Blob server refuses only the database a worker fails on, while health is Degraded
		     (owner decision 42 of 2026-10-07): a hosted Blob engine and its server over the
		     in-memory driver. -->
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Blob" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Client" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Sql.Client" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.InMemory" />
	</ItemGroup>
</Project>
