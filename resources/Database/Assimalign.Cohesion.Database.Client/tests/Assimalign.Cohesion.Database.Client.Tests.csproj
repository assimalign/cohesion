<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Database.Client.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="$(CohesionRepositoryDirectory)resources\Database\Assimalign.Cohesion.Database.Storage\tests\TestObjects\DedicatedTestTask.cs" Link="TestObjects\DedicatedTestTask.cs" />
	</ItemGroup>
	<ItemGroup>
		<CohesionPackageReference Include="Microsoft.NET.Test.Sdk" />
		<CohesionPackageReference Include="coverlet.collector" />
		<CohesionPackageReference Include="xunit" />
		<CohesionPackageReference Include="xunit.runner.visualstudio" />
		<CohesionPackageReference Include="Shouldly" />
	</ItemGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Client" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Sql.Protocol" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Graph.Protocol" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Documents.Protocol" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.KeyValuePair.Protocol" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Blob.Protocol" />
		<!-- E2E acceptance: the SQL model's server (SqlDatabaseServer, implemented
		     inside Database.Sql) + a live SQL engine over the in-memory Connections
		     driver (tests are exempt from the area layering rules). -->
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Sql" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Sql.Client" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.InMemory" />
		<!-- Dial-failure tests (owner decision 39): a refused TCP dial and the TLS layer's
		     handshake failures. -->
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.Tcp" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.Security" />
	</ItemGroup>
</Project>
