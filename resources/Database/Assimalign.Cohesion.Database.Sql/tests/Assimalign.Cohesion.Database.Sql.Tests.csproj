<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Database.Sql.Tests</RootNamespace>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<!-- Every method is compiled optimized at its first call, as NativeAOT compiles it, instead of
		     starting unoptimized and tiering up. The stack-depth tests (SqlExpressionDepthExecutionTests)
		     compare how deep the parser and each later walk can nest on one thread; with tiering, a walk
		     still in its large unoptimized frames beside an already optimized parser made the CASE row
		     fail on whichever CI runner tiered last (macOS, then Ubuntu). -->
		<TieredCompilation>false</TieredCompilation>
	</PropertyGroup>

	<ItemGroup>
		<CohesionPackageReference Include="Microsoft.NET.Test.Sdk" />
		<CohesionPackageReference Include="xunit" />
		<CohesionPackageReference Include="xunit.runner.visualstudio" />
		<CohesionPackageReference Include="coverlet.collector" />
		<CohesionPackageReference Include="Shouldly" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="xunit.runner.json" />
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\SimulatedDurableFileHandle.cs" Link="TestObjects\SimulatedDurableFileHandle.cs" />
		<!-- Rewrites index pages into the layouts the old-format refusal tests need (#1194). -->
		<Compile Include="..\..\Assimalign.Cohesion.Database.Indexing\tests\TestObjects\LegacyBTreePages.cs" Link="TestObjects\LegacyBTreePages.cs" />
		<!-- Rewrites a data file's storage format version for the storage-format refusal tests (#1251). -->
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\StorageFormatFiles.cs" Link="TestObjects\StorageFormatFiles.cs" />
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\JournalFrames.cs" Link="TestObjects\JournalFrames.cs" />
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\PageWriteLockHolder.cs" Link="TestObjects\PageWriteLockHolder.cs" />
		<!-- Device faults that fire on the engine's worker threads, for the worker resilience tests (#1268). -->
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\DeviceFaults.cs" Link="TestObjects\DeviceFaults.cs" />
		<!-- Samples the journal for the checkpoint size trigger's test (#1254). -->
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\JournalSamples.cs" Link="TestObjects\JournalSamples.cs" />
		<!-- A clock the worker failure window tests move by hand (owner decision 42). -->
		<Compile Include="..\..\Assimalign.Cohesion.Database\tests\TestObjects\ManualTimeProvider.cs" Link="TestObjects\ManualTimeProvider.cs" />
	</ItemGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Sql" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Sql.Client" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Sql.Tcp" />
		<!-- The SqlDatabaseServer suite and the AddSqlServer verb test run over the
		     in-memory Connections driver. -->
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.InMemory" />
		<!-- Lifecycle symmetry is proven against a real fixed TCP endpoint. -->
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.Tcp" />
	</ItemGroup>

</Project>
