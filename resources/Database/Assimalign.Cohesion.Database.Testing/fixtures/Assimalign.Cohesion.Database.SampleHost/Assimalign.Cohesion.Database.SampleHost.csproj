<Project Sdk="Assimalign.Cohesion.Sdk.Database">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<CohesionApplicationModel>enabled</CohesionApplicationModel>
		<CohesionDatabaseProject>true</CohesionDatabaseProject>
		<CohesionApplication>database-tests</CohesionApplication>
		<CohesionResourceName>sample-database</CohesionResourceName>
		<!-- The E2E launches this apphost directly on clean runners, where Cohesion's
		     private shared frameworks are restored as runtime packs but not installed. -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<CohesionSetting
			Include="Database:Durability"
			Default="synchronous"
			Type="Assimalign.Cohesion.Database.Storage.StorageCommitDurability" />
	</ItemGroup>
</Project>
