<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Database.Documents.AotSample</RootNamespace>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<!-- Project-local: a global PublishAot reaches the netstandard2.0 build analyzers. -->
		<PublishAot>true</PublishAot>
		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2070;IL2072;IL2075;IL2087;IL3050;IL3051</WarningsAsErrors>
		<IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
	</PropertyGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Documents" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Documents.Client" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.InMemory" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.Tcp" />
	</ItemGroup>
</Project>
