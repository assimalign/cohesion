<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Database.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<CohesionPackageReference Include="Microsoft.NET.Test.Sdk" />
		<CohesionPackageReference Include="coverlet.collector" />
		<CohesionPackageReference Include="xunit" />
		<CohesionPackageReference Include="xunit.runner.visualstudio" />
		<CohesionPackageReference Include="Shouldly" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database" />
		<!--
			The root event source's tests drive real in-memory engines (the event-sources plan, §7):
			database lifecycle, explicit transactions and statements on a Sql engine, and the
			statement re-entry of the Graph and Documents text overloads.
		-->
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Sql" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Graph" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Documents" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="xunit.runner.json" />
	</ItemGroup>
</Project>
