<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <CohesionGenerateDatabaseMappers>true</CohesionGenerateDatabaseMappers>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2070;IL2072;IL2075;IL2087;IL3050;IL3051</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <CohesionProjectReference Include="Assimalign.Cohesion.Database.Sql.Mapping" />
    <CohesionProjectReference Include="Assimalign.Cohesion.Database.Sql" />
    <CohesionProjectReference Include="Assimalign.Cohesion.Database.Sql.Schema" />
    <CohesionProjectReference Include="Assimalign.Cohesion.Connections.InMemory" />
    <CohesionAnalyzerReference Include="Assimalign.Cohesion.SourceGeneration.Database" />
    <CompilerVisibleProperty Include="CohesionGenerateDatabaseMappers" />
  </ItemGroup>
</Project>
