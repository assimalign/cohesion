<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Database.Documents.Tests</RootNamespace>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<CohesionPackageReference Include="Microsoft.NET.Test.Sdk" />
		<CohesionPackageReference Include="xunit" />
		<CohesionPackageReference Include="xunit.runner.visualstudio" />
		<CohesionPackageReference Include="coverlet.collector" />
		<CohesionPackageReference Include="Shouldly" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Documents" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.InMemory" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Documents.RecoveryFixture" ReferenceOutputAssembly="false" />
		<!-- Rewrites index pages into the layouts the old-format refusal tests need (#1194). -->
		<Compile Include="..\..\Assimalign.Cohesion.Database.Indexing\tests\TestObjects\LegacyBTreePages.cs" Link="TestObjects\LegacyBTreePages.cs" />
		<!-- Rewrites a data file's storage format version for the storage-format refusal tests (#1251). -->
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\StorageFormatFiles.cs" Link="TestObjects\StorageFormatFiles.cs" />
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\JournalFrames.cs" Link="TestObjects\JournalFrames.cs" />
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\PageWriteLockHolder.cs" Link="TestObjects\PageWriteLockHolder.cs" />
		<!-- Device faults that fire on the engine's worker threads, for the worker resilience tests (#1268). -->
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\DeviceFaults.cs" Link="TestObjects\DeviceFaults.cs" />
		<!-- Samples the journal for the checkpoint size trigger's test (#1254). -->
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\JournalSamples.cs" Link="TestObjects\JournalSamples.cs" />
	</ItemGroup>
	<Target Name="CopyDocumentRecoveryFixture" AfterTargets="Build">
		<ItemGroup>
			<DocumentRecoveryFixtureOutput Include="$(MSBuildThisFileDirectory)..\fixtures\Assimalign.Cohesion.Database.Documents.RecoveryFixture\bin\$(Configuration)\$(TargetFramework)\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(DocumentRecoveryFixtureOutput)"
		      DestinationFiles="@(DocumentRecoveryFixtureOutput->'$(OutDir)DocumentRecoveryFixture\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" />
	</Target>
</Project>
