<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.Database.Documents.Tests</RootNamespace>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<!-- Exact planning allocation guards must use one JIT tier, including in a full suite. -->
		<TieredCompilation>false</TieredCompilation>
	</PropertyGroup>
	<ItemGroup>
		<!-- #1883: an idle thread pool worker exits after 20 s, and the arrays in its thread-local ArrayPool
		     slots leave the heap with it, without the trim event the heap gate (DocumentHeapAcceptance) counts.
		     A slot is trimmed with that event only after 30 s idle at low memory pressure, so on CI runners
		     the exit came first and a heap reading lost memory the gate could not see. Workers never time
		     out here; the gate refuses to run without this setting. -->
		<RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.ThreadTimeoutMs" Value="-1" />
	</ItemGroup>
	<ItemGroup>
		<Compile Include="$(CohesionRepositoryDirectory)resources\Database\Assimalign.Cohesion.Database\tests\TestObjects\SavepointUndoFault.cs" Link="TestObjects\SavepointUndoFault.cs" />
		<Compile Include="$(CohesionRepositoryDirectory)resources\Database\Assimalign.Cohesion.Database.Transactions\tests\TestObjects\UndoMarkerDriver.cs" Link="TestObjects\UndoMarkerDriver.cs" />
		<Compile Include="$(CohesionRepositoryDirectory)resources\Database\Assimalign.Cohesion.Database.Storage\tests\TestObjects\DedicatedTestTask.cs" Link="TestObjects\DedicatedTestTask.cs" />
        <Compile Include="$(CohesionRepositoryDirectory)resources\Database\Assimalign.Cohesion.Database.Blob\tests\TestObjects\CrashReopen.cs" Link="TestObjects\CrashReopen.cs" />
		<Compile Include="$(CohesionRepositoryDirectory)resources\Database\Assimalign.Cohesion.Database\tests\TestObjects\WorkerPumpObservation.cs" Link="TestObjects\WorkerPumpObservation.cs" />
		<Compile Include="$(CohesionRepositoryDirectory)resources\Database\Assimalign.Cohesion.Database\tests\TestObjects\CheckpointPace.cs" Link="TestObjects\CheckpointPace.cs" />
		<Compile Include="$(CohesionRepositoryDirectory)build\TestSupport\EventSourceRecorder.cs" Link="Shared\EventSourceRecorder.cs" />
		<Compile Include="$(CohesionRepositoryDirectory)build\TestSupport\LiveHeap.cs" Link="Shared\LiveHeap.cs" />
		<!-- Rewrites index pages into the layouts the old-format refusal tests need (#1194). -->
		<Compile Include="..\..\Assimalign.Cohesion.Database.Indexing\tests\TestObjects\LegacyBTreePages.cs" Link="TestObjects\LegacyBTreePages.cs" />
		<!-- Rewrites a data file's storage format version for the storage-format refusal tests (#1251). -->
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\StorageFormatFiles.cs" Link="TestObjects\StorageFormatFiles.cs" />
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\JournalFrames.cs" Link="TestObjects\JournalFrames.cs" />
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\PageWriteLockHolder.cs" Link="TestObjects\PageWriteLockHolder.cs" />
		<!-- Device faults that fire on the engine's worker threads, for the worker resilience tests (#1268). -->
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\DeviceFault.cs" Link="TestObjects\DeviceFault.cs" />
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\DeviceFaults.cs" Link="TestObjects\DeviceFaults.cs" />
		<!-- Samples the journal for the checkpoint size trigger's test (#1254). -->
		<Compile Include="..\..\Assimalign.Cohesion.Database.Storage\tests\TestObjects\JournalSamples.cs" Link="TestObjects\JournalSamples.cs" />
		<!-- A clock the worker failure window tests move by hand (owner decision 42). -->
		<Compile Include="..\..\Assimalign.Cohesion.Database\tests\TestObjects\ManualTimeProvider.cs" Link="TestObjects\ManualTimeProvider.cs" />
	</ItemGroup>
	<ItemGroup>
		<CohesionPackageReference Include="Microsoft.NET.Test.Sdk" />
		<CohesionPackageReference Include="xunit" />
		<CohesionPackageReference Include="xunit.runner.visualstudio" />
		<CohesionPackageReference Include="coverlet.collector" />
		<CohesionPackageReference Include="Shouldly" />
	</ItemGroup>
	<ItemGroup>
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Documents" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.InMemory" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Connections.Tcp" />
		<CohesionProjectReference Include="Assimalign.Cohesion.Database.Documents.RecoveryFixture" ReferenceOutputAssembly="false" />
	</ItemGroup>
	<Target Name="CopyDocumentRecoveryFixture" AfterTargets="Build">
		<ItemGroup>
			<DocumentRecoveryFixtureOutput Include="$(MSBuildThisFileDirectory)..\fixtures\Assimalign.Cohesion.Database.Documents.RecoveryFixture\bin\$(Configuration)\$(TargetFramework)\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(DocumentRecoveryFixtureOutput)"
		      DestinationFiles="@(DocumentRecoveryFixtureOutput->'$(OutDir)DocumentRecoveryFixture\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" />
	</Target>
	<ItemGroup>
		<Compile Include="$(CohesionRepositoryDirectory)resources\Database\Assimalign.Cohesion.Database.Storage\tests\TestObjects\JournalTrackingStream.cs" Link="TestObjects\JournalTrackingStream.cs" />
		<Compile Include="$(CohesionRepositoryDirectory)resources\Database\Assimalign.Cohesion.Database.Storage\tests\TestObjects\FormatProbeCrash.cs" Link="TestObjects\FormatProbeCrash.cs" />
	</ItemGroup>
	<Import Project="$(CohesionRepositoryDirectory)resources\Database\FormatProbeTests.targets" />
</Project>
