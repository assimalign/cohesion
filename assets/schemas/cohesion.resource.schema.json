{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cohesion/resource/v1",
  "title": "Cohesion resource manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "kind",
    "application",
    "applicationModel",
    "artifact",
    "endpoints",
    "probes",
    "controlPlane",
    "mounts",
    "settings",
    "references",
    "commands",
    "lifecycle",
    "properties"
  ],
  "properties": {
    "schema": {
      "const": "cohesion/resource/v1"
    },
    "name": {
      "$ref": "#/definitions/resourceName"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "application": {
      "$ref": "#/definitions/resourceName"
    },
    "applicationModel": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assembly", "composable", "project", "apphost", "image"],
      "properties": {
        "assembly": {
          "type": "string",
          "minLength": 1
        },
        "composable": {
          "type": "boolean"
        },
        "project": {
          "type": ["string", "null"]
        },
        "apphost": {
          "type": ["string", "null"]
        },
        "image": {
          "type": ["string", "null"]
        }
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/endpoint"
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readiness": {
          "$ref": "#/definitions/probe"
        },
        "liveness": {
          "$ref": "#/definitions/probe"
        },
        "startup": {
          "$ref": "#/definitions/probe"
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "path"],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "mounts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/mount"
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/setting"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/reference"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lifecycle": {
      "$ref": "#/definitions/lifecycle"
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*\\..+$"
      }
    }
  },
  "definitions": {
    "resourceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "logicalName": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "scheme", "protocol", "containerPort", "public"],
      "properties": {
        "name": {
          "$ref": "#/definitions/logicalName"
        },
        "scheme": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "enum": ["tcp", "udp"]
        },
        "containerPort": {
          "$ref": "#/definitions/port"
        },
        "devPort": {
          "$ref": "#/definitions/port"
        },
        "public": {
          "type": "boolean"
        },
        "certificate": {
          "$ref": "#/definitions/logicalName"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "$ref": "#/definitions/logicalName"
        },
        "http": {
          "type": "string",
          "pattern": "^/"
        },
        "tcp": {
          "const": true
        },
        "exec": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "grpc": {
          "type": "string"
        },
        "none": {
          "const": true
        }
      },
      "oneOf": [
        { "required": ["http"] },
        { "required": ["tcp"] },
        { "required": ["exec"] },
        { "required": ["grpc"] },
        { "required": ["none"] }
      ]
    },
    "mount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "containerPath"],
      "properties": {
        "name": {
          "$ref": "#/definitions/logicalName"
        },
        "kind": {
          "enum": ["Volume", "Configuration", "Secret"]
        },
        "containerPath": {
          "type": "string",
          "pattern": "^/"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "const": "Volume" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["size"]
          }
        }
      ]
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "application", "endpoints", "optional", "manifest"],
      "properties": {
        "resource": {
          "$ref": "#/definitions/resourceName"
        },
        "application": {
          "$ref": "#/definitions/resourceName"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/logicalName"
          }
        },
        "optional": {
          "type": "boolean"
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload", "replicas", "maxReplicas", "stopGraceSeconds", "restartPolicy", "exitCodes"],
      "properties": {
        "workload": {
          "enum": ["Deployment", "StatefulSet", "Job", "DaemonSet"]
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "stopGraceSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "restartPolicy": {
          "enum": ["OnFailure", "Always", "Never"]
        },
        "exitCodes": {
          "const": "cohesion/sysexits/v1"
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  }
}
